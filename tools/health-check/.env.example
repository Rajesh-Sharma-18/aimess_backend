# Copy to .env and fill in. .env is git-ignored. Use dedicated TEST accounts.
API_ORIGIN=https://api.ai5dev.tech
WEB_ORIGIN=https://ai5dev.tech
MINIO_ORIGIN=https://minio.ai5dev.tech
STREAM_HOST=ai5stream.tech
# Website pages to load (comma-separated)
WEB_PATHS=/,/login,/create-new-account,/forgot-password,/message,/community,/notifications,/settings,/privacy-policy,/terms-of-service,/child-safety-standards,/delete-account

# Account A: API sweep, media, sockets, livestream
ACCOUNT_A=
PASSWORD_A=
# Account B: must be A's FRIEND. Enables live chat round-trip + audio/video calls (B rings briefly)
ACCOUNT_B=
PASSWORD_B=
# A community A belongs to (community chat send/receive; test message is deleted after)
COMMUNITY_ID=
# A community where A may go live (create stream -> publish creds -> stop)
STREAM_COMMUNITY_ID=
