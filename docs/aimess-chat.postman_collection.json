                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.data && j.data.objectKey) { pm.collectionVariables.set('objectKey', j.data.objectKey); }",
                  "// Then PUT your file bytes to data.uploadUrl with the same Content-Type."
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"voice.mp3\",\n  \"contentType\": \"audio/mpeg\"\n}"
            },
            "url": {
              "raw": "{{chatBase}}/media/upload-url",
              "host": ["{{chatBase}}"],
              "path": ["media", "upload-url"]
            }
          }
        },
        {
          "name": "Download URL (play/download)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objectKey\": \"{{objectKey}}\"\n}"
            },
            "url": {
              "raw": "{{chatBase}}/media/download-url",
              "host": ["{{chatBase}}"],
              "path": ["media", "download-url"]
            }
          }
        }
      ]
    },
    {
      "name": "Socket.IO (real-time) — read me",
      "item": [],
      "description": "Sending messages, reply, pin, reactions, and location/contact/voice/file attachments are SOCKET.IO events — they are NOT REST and cannot be a normal Postman request. Test them with a Postman Socket.IO request:\n\nSETUP\n1. New > Socket.IO.\n2. URL: {{socketUrl}}  (i.e. ws://localhost:3004/z-product)\n3. Settings > Handshake path: /z-socket/\n4. Headers/Auth (handshake auth): add JSON  { \"token\": \"<paste accessToken>\" }\n5. Connect.\n\nIMPORTANT: always emit the JOIN event first, then the message event.\n\n--- PRIVATE ---\nJoin:  event 'room:private:user:join'  ->  { \"roomId\": \"<roomId>\" }\nSend text:  event 'room:private:message:add'  ->\n{ \"roomId\":\"<roomId>\", \"receiverId\":\"<peerId>\", \"content\":{\"text\":\"hello\",\"urls\":[],\"files\":[]}, \"messageType\":\"TEXT\" }\nReply: same as send + \"parentMessageId\":\"<messageId>\"\nLocation: messageType \"LOCATION\", content.location = { \"lat\":21.0285, \"lng\":105.8542, \"placeName\":\"Hoan Kiem Lake\", \"placeAddress\":\"Hanoi\" }\nContact:  messageType \"CONTACT\", content.contact = { \"name\":\"Emily Cooper\", \"phone\":\"+12345 67890\" }\nPin:  event 'room:private:message:pin'  ->  { \"roomId\":\"<roomId>\", \"messageId\":\"<messageId>\" }\nReact: event 'room:private:message:react'\nThe ack returns { return_code: 'SUCCESS', data: { id: <messageId>, ... } } — copy data.id into the messageId collection variable for the REST delete/pins requests.\n\n--- GROUP ---\nJoin: 'room:group:user:join' -> { \"roomId\":\"<groupRoomId>\" }\nSend: 'room:group:message:add' -> { \"roomId\":\"<groupRoomId>\", \"content\":{\"text\":\"hi\",\"urls\":[],\"files\":[]}, \"messageType\":\"TEXT\" } (location/contact same as private, inside content)\n\n--- COMMUNITY ---\nJoin: 'room:general:user:join' -> { \"roomId\":\"<communityRoomId>\" }\nSend: 'room:general:message:add' ->\n{ \"roomId\":\"<communityRoomId>\", \"message\":\"hi\", \"messageType\":\"text\", \"username\":\"postman_a\" }\nLocation: messageType \"location\" + top-level \"location\": {lat,lng,placeName,placeAddress}\nContact:  messageType \"contact\" + top-level \"contact\": {name,phone}\nAttachment (image/file/voice): include \"media\": { \"files\": [ { \"url\":\"<uploadedUrl>\", \"key\":\"<objectKey>\", \"mime\":\"audio/mpeg\", \"size\":12345 } ] }\nCommunity ack returns { return_code:'SUCCESS', data:{ message:{ id, attachments, ... } } }.\n\nNOTE: GIF and Sticker tabs are NOT implemented yet (deferred)."
    }
  ]
}
