{
  "name": "aimess",
  "version": "1.0.0",
  "packageManager": "pnpm@11.0.8",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "node scripts/prepare-husky.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "prisma:generate": "pnpm db:generate",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "pnpm exec prettier --write . && node scripts/format-prisma.mjs",
    "format:check": "pnpm exec prettier --check .",
    "deps:fix": "node scripts/fix-pnpm-dev.mjs",
    "format:prisma": "node scripts/format-prisma.mjs",
    "add": "tsx scripts/add.ts",
    "create-service": "tsx scripts/create-service.ts",
    "dev:gateway": "pnpm --filter @aimess/api-gateway dev",
    "dev:auth": "pnpm --filter @aimess/auth-service dev",
    "dev:user": "pnpm --filter @aimess/user-service dev",
    "dev:community": "pnpm --filter @aimess/community-service dev",
    "dev:chat": "pnpm --filter @aimess/chat-service dev",
    "dev:notifications": "pnpm --filter @aimess/notifications-service dev",
    "dev:backoffice": "pnpm --filter @aimess/backoffice-service dev",
    "db:generate": "pnpm --filter @aimess/auth-service db:generate && pnpm --filter @aimess/user-service db:generate && pnpm --filter @aimess/community-service db:generate && pnpm --filter @aimess/chat-service db:generate && pnpm --filter @aimess/notifications-service db:generate && pnpm --filter @aimess/backoffice-service db:generate",
    "db:migrate:deploy": "pnpm --filter @aimess/auth-service db:migrate:deploy && pnpm --filter @aimess/user-service db:migrate:deploy && pnpm --filter @aimess/backoffice-service db:migrate:deploy",
    "db:migrate:dev:auth": "pnpm --filter @aimess/auth-service db:migrate",
    "db:migrate:dev:user": "pnpm --filter @aimess/user-service db:migrate",
    "db:migrate:dev:backoffice": "pnpm --filter @aimess/backoffice-service db:migrate",
    "db:push:community": "pnpm --filter @aimess/community-service db:push",
    "db:push:chat": "pnpm --filter @aimess/chat-service db:push",
    "db:push:notifications": "pnpm --filter @aimess/notifications-service db:push",
    "db:seed:community": "pnpm --filter @aimess/community-service db:seed",
    "db:seed:backoffice": "pnpm --filter @aimess/backoffice-service db:seed",
    "db:seed": "pnpm db:seed:community",
    "db:setup:community": "pnpm --filter @aimess/community-service db:push && pnpm --filter @aimess/community-service db:seed",
    "db:studio:auth": "pnpm --filter @aimess/auth-service exec prisma studio",
    "db:studio:user": "pnpm --filter @aimess/user-service exec prisma studio",
    "db:studio:community": "pnpm --filter @aimess/community-service exec prisma studio",
    "db:studio:chat": "pnpm --filter @aimess/chat-service exec prisma studio",
    "db:studio:notifications": "pnpm --filter @aimess/notifications-service exec prisma studio",
    "db:studio:backoffice": "pnpm --filter @aimess/backoffice-service exec prisma studio",
    "docker:up": "docker compose --env-file .env up -d",
    "docker:down": "docker compose --env-file .env down",
    "docker:build": "docker compose --env-file .env build",
    "docker:build:apps": "docker build -f apps/api-gateway/Dockerfile -t aimess-api-gateway:local . && docker build -f apps/auth-service/Dockerfile -t aimess-auth-service:local . && docker build -f apps/user-service/Dockerfile -t aimess-user-service:local . && docker build -f apps/chat-service/Dockerfile -t aimess-chat-service:local .",
    "docker:rebuild": "docker compose --env-file .env down && docker compose --env-file .env build && docker compose --env-file .env up -d",
    "docker:ps": "docker compose --env-file .env ps",
    "docker:logs": "docker compose --env-file .env logs -f",
    "tunnel:gateway": "ngrok http 3000",
    "tunnel:minio": "ngrok http 9000"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "turbo": "^2.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "pg": "^8.20.0"
  }
}
