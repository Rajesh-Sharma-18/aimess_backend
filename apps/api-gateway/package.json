{
  "name": "@aimess/api-gateway",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --include ./src --clear-screen=false src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "node ../../node_modules/jest/bin/jest.js --config jest.config.cjs",
    "asyncapi:validate": "pnpm dlx @asyncapi/cli@6 validate asyncapi/asyncapi.yaml",
    "asyncapi:preview": "pnpm dlx @asyncapi/cli@6 start studio --file asyncapi/asyncapi.yaml",
    "asyncapi:docs": "pnpm dlx @asyncapi/cli@6 generate fromTemplate asyncapi/asyncapi.yaml @asyncapi/html-template@3 --output asyncapi/output --force-write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aimess/auth-jwt": "workspace:*",
    "@aimess/errors": "workspace:*",
    "@aimess/grpc-utils": "workspace:*",
    "@aimess/logger": "workspace:*",
    "@aimess/redis": "workspace:*",
    "@aimess/utils": "workspace:*",
    "@aimess/constants": "workspace:*",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.7",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.9.0",
    "lodash": "^4.18.1",
    "opossum": "^8.1.4",
    "socket.io": "^4.8.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.2",
    "@types/opossum": "^8.1.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
