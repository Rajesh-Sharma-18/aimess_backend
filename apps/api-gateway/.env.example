NODE_ENV=development
API_GATEWAY_PORT=3000

# =========================
# Downstream HTTP services
# =========================
AUTH_SERVICE_URL=http://127.0.0.1:3001
USER_SERVICE_URL=http://127.0.0.1:3002
COMMUNITY_SERVICE_URL=http://127.0.0.1:3003
CHAT_SERVICE_URL=http://127.0.0.1:3004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3006
# media-service (presigned upload/download URLs). Without this the gateway
# does NOT register the /api/v1/media/* proxy and those routes 404.
MEDIA_SERVICE_URL=http://127.0.0.1:3009
# stream-service (livestream comments + REST). Without this the gateway does
# NOT register the /api/v1/streams/* proxy and those routes 404.
STREAM_SERVICE_URL=http://127.0.0.1:3007
BACKOFFICE_SERVICE_URL=http://127.0.0.1:3010

# =========================
# Admin edge controls (/admin/* surface)
# =========================
# Admin JWT secret — MUST equal backoffice-service JWT_ADMIN_SECRET.
JWT_ADMIN_SECRET=
# Empty = allow all (dev). Comma-separated IPs otherwise.
ADMIN_IP_WHITELIST=
ADMIN_RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_RATE_LIMIT_MAX=100
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# Public URL for Swagger (optional)
# API_PUBLIC_URL=http://localhost:3000

# Extra Swagger server URLs — comma-separated (localhost + LAN IP, etc.)
SWAGGER_SERVER_URLS=http://localhost:3000,http://10.0.127.225:3000,http://10.0.127.224:3000,https://mrpg6wbd-3000.inc1.devtunnels.ms

# =========================
# gRPC (reserved for future use)
# =========================
AUTH_GRPC_URL=0.0.0.0:5001
# user-service gRPC — REQUIRED for socket typing identity (BulkGetUserSnapshots).
USER_GRPC_URL=localhost:4002
# media-service gRPC — presigned upload/download URL generation.
MEDIA_GRPC_URL=0.0.0.0:4009

# =========================
# Redis
# =========================
# Full connection URL — unlike the other services (which take REDIS_HOST /
# REDIS_PORT / REDIS_PASSWORD separately), the gateway passes this straight to
# ioredis. Embed the password in the URL for an authenticated server:
#   redis://:<password>@<host>:<port>
# URL-encode any of : / ? # [ ] @ that appear in the password.
REDIS_URL=redis://localhost:6379

# =========================
# CORS (comma-separated origins)
# =========================
CORS_ALLOWED_ORIGINS=*

# Request headers reflected in the CORS preflight (Access-Control-Allow-Headers).
# Must include every custom header the web client sends (e.g. x-lang) or the
# browser blocks the request at preflight. Defaults to this list if unset.
CORS_ALLOWED_HEADERS=Content-Type,Authorization,x-lang

# =========================
# Rate limiting
# =========================
# Master switch. Set false for local dev and the E2E harness ONLY.
# Health and docs paths are skipped regardless of this value.
RATE_LIMIT_ENABLED=true
# Global backstop, NOT the per-operation limit. Bucketed per session (bearer
# token digest) when authenticated, per IP when anonymous — so users sharing one
# egress IP (office, campus, CGNAT, VPN) no longer share one quota.
GLOBAL_RATE_LIMIT_WINDOW_MINUTES=1
GLOBAL_RATE_LIMIT_MAX=200
# Sensitive auth endpoints (registration, password reset, social sign-in, the
# signup challenge). Per IP — the caller has no credential yet, and per-IP is the
# axis a credential-stuffing run varies least. Do NOT raise this to work around a
# client retry bug.
SENSITIVE_AUTH_RATE_LIMIT_WINDOW_MINUTES=15
SENSITIVE_AUTH_RATE_LIMIT_MAX=20
# Account-availability probe, login and refresh each have their OWN counter
# (Redis keys rl:gw:auth.account-validate / auth.login / auth.refresh). They used
# to share the SENSITIVE_AUTH bucket above, so typing a name into a signup form
# spent the budget for signing in and then for refreshing the session.
#
# The probe is UI-rate traffic: a debounced field asks it while the user types,
# so it gets a short window and a higher ceiling.
ACCOUNT_VALIDATE_RATE_LIMIT_WINDOW_MINUTES=1
ACCOUNT_VALIDATE_RATE_LIMIT_MAX=30
# Login counts FAILED attempts only — a successful sign-in is refunded, so a
# shared egress address cannot accumulate a ban out of people signing in. The
# per-account lockout in auth-service (AUTH_MAX_FAILED_LOGINS) is the control
# that stops a distributed run; this bounds one address.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=5
LOGIN_RATE_LIMIT_MAX=15
# Refresh is background behaviour every open tab performs. Deliberately
# generous: the credential on this path is a 256-bit token that is not guessable
# at any request rate, and throttling it signs people out of valid sessions.
REFRESH_RATE_LIMIT_WINDOW_MINUTES=5
REFRESH_RATE_LIMIT_MAX=60
# OTP verify/resend. Separate bucket from login: real users retry an OTP more
# often than they retry a password.
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=15
# Read/poll endpoints, per session. Generous on purpose — a read limit set near
# a write limit is what makes a working app feel broken.
READ_RATE_LIMIT_MAX=300
# Free-text search, per session (each call fans out to several services).
SEARCH_RATE_LIMIT_MAX=60
# Livestream REST (/streams/*), per session. Shared across comment paging,
# viewer polling and moderation, so keep it generous. The publisher heartbeat
# and quality reports are exempt from this bucket entirely.
STREAM_RATE_LIMIT_MAX=200

# Reverse-proxy hops (0 = local dev; 1 behind nginx/load balancer)
TRUST_PROXY_HOPS=0

# =========================
# App version (mobile force / optional update)
# =========================
# Used when config/app-versions.json is missing. Copy app-versions.example.json to app-versions.json to override.
APP_VERSION_ANDROID_MANDATORY=1.0.0
APP_VERSION_ANDROID_OPTIONAL=1.0.0
# APP_VERSION_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.aimess.app
APP_VERSION_IOS_MANDATORY=1.0.0
APP_VERSION_IOS_OPTIONAL=1.0.0
# APP_VERSION_IOS_STORE_URL=https://apps.apple.com/app/id000000000
# Optional JSON policy file to override the env-var version pins above.
# APP_VERSION_CONFIG_PATH=

# =========================
# JWT Configuration and GRPC URLs for other services (reserved)
# =========================
CHAT_GRPC_URL=localhost:4004
COMMUNITY_GRPC_URL=localhost:4003
NOTIFICATION_GRPC_URL=localhost:4006
STREAM_GRPC_URL=0.0.0.0:4007
JWT_ACCESS_SECRET=

# =========================
# Community deep linking / link host (ai5dev.tech) — DEEP_LINKING_INTEGRATION.md §2/§5
# =========================
# Comma-separated hostnames the gateway treats as the dedicated LINK domain. On these
# Hosts the gateway serves /.well-known/* + the server-rendered "Open in app" preview
# INSTEAD of the API; any other Host falls through to normal API routing.
# NOTE: this host is SHARED with the marketing site, so the link routes are
# namespaced (/+<code>, /g/<token>, /community/<handle>) and never the bare host.
LINK_HOSTS=ai5dev.tech
# Custom URL scheme for app deep links (aimess://join?code=… / aimess://resolve?handle=…).
APP_SCHEME=aimess
# Web app origin for "Continue on web" + logged-out returnTo redirects.
WEB_APP_URL=https://ai5dev.tech

# --- Android App Links (/.well-known/assetlinks.json) ---
ANDROID_PACKAGE_NAME=com.aifivetech.aimess.app
# REQUIRED IN PROD: comma-separated SHA-256 signing-cert fingerprints. MUST include BOTH
# the upload cert AND the Google Play App Signing cert (Play Console → App integrity), or
# Android App Links silently fall back to the browser. Empty in dev.
# Play App Signing cert FIRST, upload/internal cert second.
ANDROID_SHA256_CERT_FINGERPRINTS=B2:D0:AA:F8:1B:A6:64:8F:65:AB:FE:8F:CD:C8:35:94:4A:7E:CC:EE:A9:86:9D:0F:30:2F:CA:3C:84:A3:FE:FD,E5:BC:9F:BA:B2:FF:1A:C0:EF:A6:89:B3:DA:B0:F2:14:3A:7F:CE:8A:F9:66:C5:A8:9D:E9:DA:3A:09:32:E8:95
# Package id placed in the deferred-link Play Store referrer fallback.
ANDROID_STORE_APP_ID=com.aifivetech.aimess.app

# APPLE_STORE_APP_ID=000000000
# comma-separated "<TEAMID>.com.aifivetech.aimess.app" app IDs. Confirm the team id against
# the Apple Developer portal before deploying - a wrong value fails verification silently.
APPLE_APP_IDS=
# Numeric App Store id, used for the iOS deferred-link App Store fallback in the
# interstitial. Unset degrades that fallback to a web redirect instead of the store.
APPLE_STORE_APP_ID=

# --- Internal community card (OG unfurl for the link preview page) ---
# REMOVED. The secret-gated internal card route was replaced by the PUBLIC
# `/api/v1/communities/by-handle/:handle/card` endpoint, so COMMUNITY_INTERNAL_URL
# and INTERNAL_SHARED_SECRET are read by no code. They are gone rather than left
# in place: a documented control that does not exist is worse than no control,
# because the real protection (network isolation plus the gateway's
# enumeration limiter) then never gets verified.

# --- LiveKit signed-webhook verification ---
# Same api-key/secret pair as the LiveKit server (docker/livekit/config.yaml
# `webhook.api_key` + docker-compose `LIVEKIT_KEYS`). Wrong pair = 401 on all
# incoming webhooks.
# REQUIRED — no schema default. Both were previously shipped with a working
# key/secret pair, so a deployment that forgot them still verified anything an
# attacker signed with the published value. Generate per environment:
#   LIVEKIT_API_KEY:    openssl rand -hex 8
#   LIVEKIT_API_SECRET: openssl rand -base64 32   (min 32 chars)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# =========================
# Internal gRPC service auth
# =========================
# Shared bearer token every service attaches to outgoing gRPC calls and
# validates on incoming ones. MUST be identical across ALL services.
# Unset + NODE_ENV=production => services refuse to start (fail fast rather
# than silently accepting anonymous internal calls). Unset in dev => auth is
# disabled with a startup warning. A value published in this repository (the
# old "dev-grpc-service-token-change-me") is now rejected in production too.
# Generate one per environment: openssl rand -base64 32
GRPC_SERVICE_TOKEN=
