NODE_ENV=development
API_GATEWAY_PORT=3000

# =========================
# Downstream HTTP services
# =========================
AUTH_SERVICE_URL=http://127.0.0.1:3001
USER_SERVICE_URL=http://127.0.0.1:3002
COMMUNITY_SERVICE_URL=http://127.0.0.1:3003
CHAT_SERVICE_URL=http://127.0.0.1:3004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3006
# media-service (presigned upload/download URLs). Without this the gateway
# does NOT register the /api/v1/media/* proxy and those routes 404.
MEDIA_SERVICE_URL=http://127.0.0.1:3009
# stream-service (livestream comments + REST). Without this the gateway does
# NOT register the /api/v1/streams/* proxy and those routes 404.
STREAM_SERVICE_URL=http://127.0.0.1:3007
BACKOFFICE_SERVICE_URL=http://127.0.0.1:3010

# =========================
# Admin edge controls (/admin/* surface)
# =========================
# Admin JWT secret — MUST equal backoffice-service JWT_ADMIN_SECRET.
JWT_ADMIN_SECRET=
# Empty = allow all (dev). Comma-separated IPs otherwise.
ADMIN_IP_WHITELIST=
ADMIN_RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_RATE_LIMIT_MAX=100
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# Public URL for Swagger (optional)
# API_PUBLIC_URL=http://localhost:3000

# Extra Swagger server URLs — comma-separated (localhost + LAN IP, etc.)
SWAGGER_SERVER_URLS=http://localhost:3000,http://10.0.127.225:3000,http://10.0.127.224:3000,https://mrpg6wbd-3000.inc1.devtunnels.ms

# =========================
# gRPC (reserved for future use)
# =========================
AUTH_GRPC_URL=0.0.0.0:5001
# user-service gRPC — REQUIRED for socket typing identity (BulkGetUserSnapshots).
USER_GRPC_URL=localhost:4002
# media-service gRPC — presigned upload/download URL generation.
MEDIA_GRPC_URL=0.0.0.0:4009

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6379

# =========================
# CORS (comma-separated origins)
# =========================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://localhost:4001,https://aimess.vasundharasolutions.com,http://localhost:8000

# Request headers reflected in the CORS preflight (Access-Control-Allow-Headers).
# Must include every custom header the web client sends (e.g. x-lang) or the
# browser blocks the request at preflight. Defaults to this list if unset.
CORS_ALLOWED_HEADERS=Content-Type,Authorization,x-lang

# =========================
# Rate limiting
# =========================
# Global limiter — skipped entirely when NODE_ENV=development.
# In production set GLOBAL_RATE_LIMIT_MAX to a sane value (e.g. 200).
GLOBAL_RATE_LIMIT_WINDOW_MINUTES=1
GLOBAL_RATE_LIMIT_MAX=200
# Sensitive auth endpoints (login, password reset, social sign-in)
SENSITIVE_AUTH_RATE_LIMIT_WINDOW_MINUTES=15
SENSITIVE_AUTH_RATE_LIMIT_MAX=20

# Reverse-proxy hops (0 = local dev; 1 behind nginx/load balancer)
TRUST_PROXY_HOPS=0

# =========================
# App version (mobile force / optional update)
# =========================
# Used when config/app-versions.json is missing. Copy app-versions.example.json to app-versions.json to override.
APP_VERSION_ANDROID_MANDATORY=1.0.0
APP_VERSION_ANDROID_OPTIONAL=1.0.0
# APP_VERSION_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.aimess.app
APP_VERSION_IOS_MANDATORY=1.0.0
APP_VERSION_IOS_OPTIONAL=1.0.0
# APP_VERSION_IOS_STORE_URL=https://apps.apple.com/app/id000000000
# Optional JSON policy file to override the env-var version pins above.
# APP_VERSION_CONFIG_PATH=

# =========================
# JWT Configuration and GRPC URLs for other services (reserved)
# =========================
CHAT_GRPC_URL=localhost:4004
COMMUNITY_GRPC_URL=localhost:4003
NOTIFICATION_GRPC_URL=localhost:4006
STREAM_GRPC_URL=0.0.0.0:4007
JWT_ACCESS_SECRET=

# =========================
# Community deep linking / link host (aimess.me) — Sharing & Deep-Linking spec §2/§7/§8
# =========================
# Comma-separated hostnames the gateway treats as the dedicated LINK domain. On these
# Hosts the gateway serves /.well-known/* + the server-rendered "Open in app" preview
# INSTEAD of the API; any other Host falls through to normal API routing.
LINK_HOSTS=aimess.me
# Custom URL scheme for app deep links (aimess://join?code=… / aimess://resolve?handle=…).
APP_SCHEME=aimess
# Web app origin for "Continue on web" + logged-out returnTo redirects.
WEB_APP_URL=https://aimess.com

# --- Android App Links (/.well-known/assetlinks.json) ---
ANDROID_PACKAGE_NAME=com.aimess.app
# REQUIRED IN PROD: comma-separated SHA-256 signing-cert fingerprints. MUST include BOTH
# the upload cert AND the Google Play App Signing cert (Play Console → App integrity), or
# Android App Links silently fall back to the browser. Empty in dev.
ANDROID_SHA256_CERT_FINGERPRINTS=
# Optional: package id placed in the deferred-link Play Store referrer fallback.
# ANDROID_STORE_APP_ID=com.aimess.app

# --- iOS Universal Links (/.well-known/apple-app-site-association) ---
# REQUIRED IN PROD: comma-separated "<TEAMID>.com.aimess.app" app IDs. Empty in dev.
APPLE_APP_IDS=
# Optional: numeric App Store id used in the iOS deferred-link App Store fallback.
# APPLE_STORE_APP_ID=000000000

# --- Internal community card (OG unfurl for the link preview page) ---
# Base URL of community-service for the shared-secret internal card endpoint
# (GET /internal/communities/by-handle/:handle/card). Without it the preview still
# renders, but with a generic card (no per-community OG metadata).
COMMUNITY_INTERNAL_URL=http://127.0.0.1:3003
# Shared secret for service-to-service internal calls. MUST equal community-service
# INTERNAL_SHARED_SECRET. If unset, the internal card endpoint is disabled (404).
INTERNAL_SHARED_SECRET=

# --- LiveKit signed-webhook verification ---
# Same api-key/secret pair as the LiveKit server (docker/livekit/config.yaml
# `webhook.api_key` + docker-compose `LIVEKIT_KEYS`). Wrong pair = 401 on all
# incoming webhooks.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretchangeme_at_least_32_chars_long