NODE_ENV=development
API_GATEWAY_PORT=3000

# =========================
# Downstream HTTP services
# =========================
AUTH_SERVICE_URL=http://127.0.0.1:3001
USER_SERVICE_URL=http://127.0.0.1:3002

# Public URL for Swagger (optional)
# API_PUBLIC_URL=http://localhost:3000

# Extra Swagger server URLs — comma-separated (localhost + LAN IP, etc.)
SWAGGER_SERVER_URLS=http://localhost:3000,http://10.0.127.225:3000

# =========================
# gRPC (reserved for future use)
# =========================
AUTH_GRPC_URL=0.0.0.0:5001
USER_GRPC_URL=0.0.0.0:5002

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6379

# =========================
# CORS (comma-separated origins)
# =========================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Reverse-proxy hops (0 = local dev; 1 behind nginx/load balancer)
TRUST_PROXY_HOPS=0
