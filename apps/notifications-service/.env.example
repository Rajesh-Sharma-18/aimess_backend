NODE_ENV=development
NOTIFICATIONS_SERVICE_PORT=3006

# =========================
# REDIS
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379

# =========================
# RabbitMQ
# =========================

# =========================
# Firebase (optional until push is enabled; empty strings are allowed in dev)
# =========================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =========================
# SMTP (e.g. MailHog on 1025 for local dev)
# =========================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=user
SMTP_PASS=pass
SMTP_FROM=no-reply@aimess.com
