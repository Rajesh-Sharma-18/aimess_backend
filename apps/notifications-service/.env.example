NODE_ENV=development
NOTIFICATIONS_SERVICE_PORT=3006
NOTIFICATIONS_GRPC_PORT=4006

# =========================
# REDIS
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave EMPTY for a local unauthenticated Redis. REQUIRED for any shared or
# remote Redis (which must never be left open) — without it every command
# fails with NOAUTH.
REDIS_PASSWORD=

# =========================
# RabbitMQ
# =========================
RABBITMQ_URL=

# =========================
# MongoDB (device-token store â€” notifications-service owns this DB; Prisma mongodb)
# Provide a complete MONGO_DATABASE_URL, OR the MONGO_* parts below (the URL is
# composed from them in src/config/env.ts and prisma.config.ts).
# =========================
MONGO_DATABASE_URL=
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=admin
MONGODB_PORT=27017
MONGO_HOST=localhost
MONGO_DB_NAME=aimess_notifications

# =========================
# gRPC targets (outbound, opossum-wrapped)
# =========================
AUTH_GRPC_URL=0.0.0.0:4001
USER_SERVICE_GRPC_URL=0.0.0.0:4002
CHAT_SERVICE_GRPC_URL=0.0.0.0:4004
COMMUNITY_SERVICE_GRPC_URL=0.0.0.0:4003
AUTH_GRPC_URL=0.0.0.0:4001

# Cached notification-settings TTL (seconds)
NOTIF_SETTINGS_CACHE_TTL_SEC=300

# Stale device-token sweeper. Deletes push tokens unseen (registered or
# successfully pushed to) for DEVICE_TOKEN_TTL_DAYS — the backstop for devices
# no revocation event will ever name: naturally expired sessions, uninstalled
# apps, browsers that cleared site data.
DEVICE_TOKEN_TTL_DAYS=60
DEVICE_TOKEN_SWEEPER_INTERVAL_MS=21600000

# =========================
# Auth (verifies device-registration requests; must match auth-service)
# =========================
JWT_ACCESS_SECRET=

# =========================
# Firebase (optional until push is enabled; empty strings are allowed in dev)
# =========================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =========================
# APNs VoIP push (iOS call ringing â€” bypasses FCM, required for reliable
# call wake on iOS). Paste the full .p8 AuthKey file contents into
# APNS_PRIVATE_KEY, newlines escaped as \n, same as FIREBASE_PRIVATE_KEY above.
# APNS_PRODUCTION=false uses api.sandbox.push.apple.com (dev/TestFlight
# builds signed with a dev provisioning profile); true uses api.push.apple.com.
# =========================
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false

# =========================
# SMTP (Gmail; SMTP_PASS must be a 16-char Google App Password, NOT your login password)
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-account@gmail.com

# =========================
# Internal gRPC service auth
# =========================
# Shared bearer token every service attaches to outgoing gRPC calls and
# validates on incoming ones. MUST be identical across ALL services.
# Unset + NODE_ENV=production => services refuse to start (fail fast rather
# than silently accepting anonymous internal calls). Unset in dev => auth is
# disabled with a startup warning.
GRPC_SERVICE_TOKEN=dev-grpc-service-token-change-me
