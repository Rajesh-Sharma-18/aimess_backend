// =============================================================================
// notifications-service  ·  MongoDB  ·  aimess_notifications
// Owns: device-token store (FCM push fan-out).
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  // Runtime PrismaClient overrides this via datasourceUrl (composed from MONGO_*
  // parts in src/config/env.ts); prisma.config.ts composes it for CLI commands.
  url      = env("MONGO_DATABASE_URL")
}

// -------------------------------------------   
// One row per (userId, token). `token` is globally unique so re-registering the
// same token from a different user moves ownership.
// -----------------------------------------------------------------------------
model DeviceToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String
  token      String   @unique
  platform   String
  // "FCM" (default) for regular push, "VOIP" for an iOS PushKit token used
  // only for call-ringing pushes over APNs (never FCM).
  tokenType  String   @default("FCM")
  deviceId   String?
  // auth-service session that registered this token, taken from the caller's
  // JWT. It is the ONLY reliable link back to a session: `deviceId` is a
  // client-generated opaque id while Session.deviceId is a server-side
  // sha256(userAgent|ip) fingerprint, so the two never match. Session
  // revocation (logout, "Logout Device", sign-out-all) deletes by this field.
  // Nullable for rows registered before this field existed.
  sessionId  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, sessionId])
  @@map("device_tokens")
}
