NODE_ENV=development

CHAT_SERVICE_PORT=3004
CHAT_GRPC_PORT=4004

# MongoDB
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=
MONGODB_PORT=

# Redis (single-node, default)
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave EMPTY for a local unauthenticated Redis. REQUIRED for any shared or
# remote Redis (which must never be left open) — without it every command
# fails with NOAUTH.
REDIS_PASSWORD=

# Redis Cluster (optional â€” overrides REDIS_HOST/PORT when set).
# Start the cluster with `docker compose up redis-node-1 redis-node-2 redis-node-3 redis-cluster-init`.
# REDIS_CLUSTER_NODES=127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003

# JWT
JWT_ACCESS_SECRET=your-jwt-access-secret

# RabbitMQ (reserved for future use)
RABBITMQ_URL=amqp://localhost:5672

# MinIO / S3 compatible storage
MINIO_ENDPOINT=http://localhost:9000
# Client-facing MinIO host used to sign upload/view URLs (LAN IP in dev, CDN/public domain in prod).
# Leave blank to reuse MINIO_ENDPOINT (only works when the client is on the same machine).
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aimess-chat
# Sibling buckets on the shared MinIO. chat-service does not upload here, but
# must know their names to presign view URLs for avatar / community-image object
# keys carried on chat snapshots (senderAvatar, room logo, etc.).
MINIO_BUCKET_AVATARS=aimess-avatars
MINIO_BUCKET_COMMUNITY=aimess-community
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRES_IN=300
# Presigned GET for chat media display (bucket private)
MINIO_VIEW_EXPIRES_IN=3600

# =========================
# Outbound HTTP (REST fallback for snapshot fetching)
# =========================
# user-service REST URL â€” snapshot fetching fallback when gRPC is unavailable
USER_SERVICE_URL=http://localhost:3002
# auth-service REST URL â€” fallback to resolve account name before profile is set
AUTH_SERVICE_URL=http://localhost:3001
# 50 MB default (generic per-file cap â€” GIF/legacy CUSTOM only)
CHAT_UPLOAD_MAX_BYTES=52428800
# 100 MB cap for video attachments
CHAT_VIDEO_MAX_BYTES=104857600
# 25 MB caps for image / audio / document attachments â€” must match
# media-service's .env.example values (same vars, shared limit).
CHAT_IMAGE_MAX_BYTES=26214400
CHAT_AUDIO_MAX_BYTES=26214400
CHAT_DOCUMENT_MAX_BYTES=26214400
# Max characters for a chat message body (send + edit)
CHAT_TEXT_MAX_CHARS=4000

# Pagination defaults
MESSAGE_PAGE_SIZE=30
CONVERSATION_PAGE_SIZE=20
PIN_LIMIT_PER_ROOM=50

AUTH_GRPC_URL=0.0.0.0:4001

# =========================
# gRPC outbound targets
# =========================
USER_SERVICE_GRPC_URL=0.0.0.0:4002
COMMUNITY_GRPC_URL=0.0.0.0:4003
# notifications-service gRPC â€” notification dispatch from chat events
NOTIFICATION_GRPC_URL=0.0.0.0:4006

# =========================
# MongoDB database name
# =========================
MONGO_HOST=localhost
MONGO_DB_NAME=aimess_chat

# =========================
# Community room reconciliation
# =========================
COMMUNITY_ROOM_RECONCILE_ENABLED=true

# =========================
# Friendship cache
# =========================
# Cached friendship check TTL (seconds)
FRIENDSHIP_CACHE_TTL_SEC=600

# =========================
# LiveKit / Calls (self-hosted)
# =========================
# ws://localhost:7880 for local dev (docker-compose `livekit`).
# wss://livekit.example.com in prod.
LIVEKIT_URL=ws://localhost:7880
# Must match the docker-compose LIVEKIT_KEYS pair (root .env).
# REQUIRED — no schema default. Both were previously shipped with a working
# key/secret pair, so a deployment that forgot them still verified anything an
# attacker signed with the published value. Generate per environment:
#   LIVEKIT_API_KEY:    openssl rand -hex 8
#   LIVEKIT_API_SECRET: openssl rand -base64 32   (min 32 chars)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Token TTL (seconds). 3h covers a call + reconnects with room to spare.
LIVEKIT_TOKEN_TTL=10800
# Unanswered calls become MISSED after this many seconds.
CALL_RINGING_TIMEOUT_SEC=60
# How often each chat-service node checks for expired ringing calls.
CALL_TIMEOUT_SWEEP_INTERVAL_SEC=15
CALL_TIMEOUT_SWEEP_BATCH=100

# How long a "Login Detected" alert stays actionable (Terminate / It's Me).
# When it lapses with no user action the server resolves it as "It's Me" —
# the session is never auto-terminated. 1 hour. Lower it only for manual
# testing; automated tests inject their own value.
LOGIN_DETECTION_TIMEOUT_MS=3600000
# How often each chat-service node looks for lapsed Login Detected alerts.
LOGIN_EXPIRY_SWEEP_INTERVAL_SEC=60
LOGIN_EXPIRY_SWEEP_BATCH=200

# =========================
# Internal gRPC service auth
# =========================
# Shared bearer token every service attaches to outgoing gRPC calls and
# validates on incoming ones. MUST be identical across ALL services.
# Unset + NODE_ENV=production => services refuse to start (fail fast rather
# than silently accepting anonymous internal calls). Unset in dev => auth is
# disabled with a startup warning. A value published in this repository (the
# old "dev-grpc-service-token-change-me") is now rejected in production too.
# Generate one per environment: openssl rand -base64 32
GRPC_SERVICE_TOKEN=

# media-service gRPC — attachment scan-verdict verification at message-send time.
# CHAT_MEDIA_VERIFY_ENABLED=false disables the gate; leave it ON in production.
MEDIA_GRPC_URL=0.0.0.0:4009
CHAT_MEDIA_VERIFY_ENABLED=true
