NODE_ENV=development

CHAT_SERVICE_PORT=3004
CHAT_GRPC_PORT=4004

# MongoDB
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=
MONGODB_PORT=

# Redis (single-node, default)
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis Cluster (optional — overrides REDIS_HOST/PORT when set).
# Start the cluster with `docker compose up redis-node-1 redis-node-2 redis-node-3 redis-cluster-init`.
# REDIS_CLUSTER_NODES=127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003

# JWT
JWT_ACCESS_SECRET=your-jwt-access-secret

# RabbitMQ (reserved for future use)
RABBITMQ_URL=amqp://localhost:5672

# MinIO / S3 compatible storage
MINIO_ENDPOINT=http://localhost:9000
# Client-facing MinIO host used to sign upload/view URLs (LAN IP in dev, CDN/public domain in prod).
# Leave blank to reuse MINIO_ENDPOINT (only works when the client is on the same machine).
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aimess-chat
# Sibling buckets on the shared MinIO. chat-service does not upload here, but
# must know their names to presign view URLs for avatar / community-image object
# keys carried on chat snapshots (senderAvatar, room logo, etc.).
MINIO_BUCKET_AVATARS=aimess-avatars
MINIO_BUCKET_COMMUNITY=aimess-community
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRES_IN=300
# Presigned GET for chat media display (bucket private)
MINIO_VIEW_EXPIRES_IN=3600

# =========================
# Outbound HTTP (REST fallback for snapshot fetching)
# =========================
# user-service REST URL — snapshot fetching fallback when gRPC is unavailable
USER_SERVICE_URL=http://localhost:3002
# auth-service REST URL — fallback to resolve account name before profile is set
AUTH_SERVICE_URL=http://localhost:3001
# 50 MB default (generic per-file cap)
CHAT_UPLOAD_MAX_BYTES=52428800
# 100 MB cap for video attachments
CHAT_VIDEO_MAX_BYTES=104857600
# Max characters for a chat message body (send + edit)
CHAT_TEXT_MAX_CHARS=4000

# Pagination defaults
MESSAGE_PAGE_SIZE=30
CONVERSATION_PAGE_SIZE=20
PIN_LIMIT_PER_ROOM=50

AUTH_GRPC_URL=0.0.0.0:4001

# =========================
# gRPC outbound targets
# =========================
USER_SERVICE_GRPC_URL=0.0.0.0:4002
COMMUNITY_GRPC_URL=0.0.0.0:4003
# notifications-service gRPC — notification dispatch from chat events
NOTIFICATION_GRPC_URL=0.0.0.0:4006

# =========================
# MongoDB database name
# =========================
MONGO_HOST=localhost
MONGO_DB_NAME=aimess_chat

# =========================
# Community room reconciliation
# =========================
COMMUNITY_ROOM_RECONCILE_ENABLED=true

# =========================
# Friendship cache
# =========================
# Cached friendship check TTL (seconds)
FRIENDSHIP_CACHE_TTL_SEC=600

# =========================
# WebRTC / Calls
# =========================
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN server — needed for production (NAT traversal). Leave blank to rely on STUN only.
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=
WEBRTC_TURN_CREDENTIAL_EXPIRES_IN_HOURS=24
WEBRTC_ICE_CANDIDATE_POOL_SIZE=10
WEBRTC_RTC_CODEC_PREFERENCES=opus,h264
WEBRTC_CALL_TIMEOUT_SEC=120
