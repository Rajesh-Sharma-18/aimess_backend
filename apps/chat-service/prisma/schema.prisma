// =============================================================================
// chat-service  ·  MongoDB  ·  chat_db
// Owns: private messaging, group messaging, community rooms,
//       notifications, pins.
//       (Livestream comments are owned by stream-service.)
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}


datasource db {
  provider = "mongodb"
  // Required by the Prisma v6 CLI. Runtime PrismaClient overrides this via
  // datasourceUrl (composed from MONGO_* parts in src/config/env.ts), and
  // prisma.config.ts composes it for CLI commands.
  url      = env("MONGO_DATABASE_URL")
}

// -----------------------------------------------------------------------------
// PrivateRoom
// -----------------------------------------------------------------------------
model PrivateRoom {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId                    String   @unique
  participants              String[]
  participantsKey           String   @unique
  lastMessageId             String?  @db.ObjectId
  lastMessageAt             DateTime?
  lastMessage               Json?
  unreadCountByUser         Json     @default("{}")
  lastReadAtByUser          Json     @default("{}")
  lastReadMessageIdByUser   Json     @default("{}")
  hasUnreadByUser           Json     @default("{}")
  firstUnreadMessageIdByUser Json    @default("{}")
  lastUnreadMessageIdByUser Json     @default("{}")
  lastUnreadPreviewByUser   Json     @default("{}")
  blockedBy                 Json     @default("[]")
  deletedFor                Json     @default("{}")
  mutedBy                   Json     @default("{}")
  archivedBy                Json     @default("{}")
  pinnedCount               Int      @default(0)
  lastPinnedAt              DateTime?
  lastSequence              Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([participants])
  @@index([lastMessageAt(sort: Desc)])
  @@map("private_rooms")
}

// -----------------------------------------------------------------------------
// PrivateMessage
// -----------------------------------------------------------------------------
model PrivateMessage {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId           String
  senderId         String?
  receiverId       String?
  content          Json      @default("{\"text\": \"\", \"urls\": [], \"files\": []}")
  messageType      String    @default("TEXT")
  systemEvent      String?
  systemData       Json?
  readBy           Json      @default("[]")
  reactions        Json      @default("{}")
  inviteLinkData   Json?
  parentMessageId  String?   @db.ObjectId
  quoteData        Json?
  clientInfo      Json?
  clientMessageId  String?
  isForwarded      Boolean   @default(false)
  forwardData      Json?
  deletedFor       Json      @default("{}")
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  deletedBy        String?
  sequenceNumber   Int       @default(0)
  createdAt        DateTime  @default(now())
  editedAt         DateTime?
  editHistory      Json      @default("[]")
  deliveredTo      Json      @default("[]")
  deliveredAt      Json      @default("{}")

  @@index([roomId, createdAt(sort: Desc)])
  // sequenceNumber trails createdAt so timestamp-paginated reads (findByRoomIdTimeline)
  // get a deterministic, index-backed total order with early-termination preserved.
  @@index([roomId, isDeleted, createdAt(sort: Desc), sequenceNumber(sort: Desc)])
  @@index([roomId, parentMessageId, createdAt(sort: Desc)])
  @@index([roomId, messageType, createdAt(sort: Desc)])
  @@index([roomId, sequenceNumber])
  @@index([systemEvent])
  @@index([clientMessageId])
  @@map("private_messages")
}

// -----------------------------------------------------------------------------
// PrivateMessagePin
// -----------------------------------------------------------------------------
model PrivateMessagePin {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId            String
  messageId         String   @db.ObjectId
  pinnedBy          String
  pinnedAt          DateTime @default(now())
  messageCreatedAt  DateTime
  senderId          String
  senderDisplayName String   @default("")
  senderAvatar      String   @default("")
  contentPinned     Json     @default("{\"text\": \"\", \"urls\": [], \"files\": []}")
  deletedFor        Json     @default("{}")

  @@unique([roomId, messageId, pinnedBy])
  @@index([roomId, pinnedAt(sort: Desc)])
  @@index([roomId, messageCreatedAt(sort: Desc), pinnedAt(sort: Desc)])
  @@map("private_message_pins")
}

// -----------------------------------------------------------------------------
// GroupRoom
// -----------------------------------------------------------------------------
model GroupRoom {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId             String    @unique
  type               String    @default("GROUP")
  name               String
  avatar             String    @default("")
  description        String    @default("")
  createdBy          String
  status             String    @default("ACTIVE")
  memberLimit        Int       @default(50)
  memberCount        Int       @default(1)
  settings           Json      @default("{\"allowMemberInviteLink\": true, \"allowMemberSendInviteLink\": true, \"allowReply\": true, \"allowPin\": true}")
  lastMessageId      String?   @db.ObjectId
  lastMessageAt      DateTime?
  lastMessagePreview Json?
  pinnedCount        Int       @default(0)
  lastPinnedAt       DateTime?
  lastSequence       Int       @default(0)
  archivedBy         Json      @default("{}")
  disbandedAt        DateTime?
  disbandedBy        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([type])
  @@index([createdBy])
  @@index([status])
  @@index([memberCount])
  @@index([status, lastMessageAt(sort: Desc)])
  @@index([createdBy, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, memberCount(sort: Desc)])
  @@map("group_rooms")
}

// -----------------------------------------------------------------------------
// GroupMessage
// -----------------------------------------------------------------------------
model GroupMessage {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId             String
  clientMessageId    String?
  clientInfo         Json?
  senderId           String?
  senderName         String    @default("")
  senderAvatar       String    @default("")
  messageType        String    @default("TEXT")
  content            Json      @default("{\"text\": \"\", \"urls\": [], \"files\": []}")
  systemEvent        String?
  systemData         Json?
  inviteLinkData     Json?
  parentMessageId    String?   @db.ObjectId
  quoteData          Json?
  reactions          Json      @default("{}")
  isForwarded        Boolean   @default(false)
  forwardData        Json?
  isDeleted          Boolean   @default(false)
  deletedType        String?
  deletedPlaceholder String    @default("")
  deletedAt          DateTime?
  deletedBy          String?
  deletedForUserIds  Json      @default("[]")
  sequenceNumber     Int       @default(0)
  createdAt          DateTime  @default(now())
  editedAt           DateTime?
  editHistory        Json      @default("[]")

  // sequenceNumber trails createdAt so timestamp-paginated reads (findByRoomIdTimeline)
  // get a deterministic, index-backed total order with early-termination preserved.
  @@index([roomId, createdAt(sort: Desc), sequenceNumber(sort: Desc)])
  @@index([roomId, isDeleted, createdAt(sort: Desc)])
  @@index([roomId, parentMessageId, createdAt(sort: Desc)])
  @@index([roomId, messageType, createdAt(sort: Desc)])
  @@index([roomId, sequenceNumber])
  @@index([clientMessageId])
  @@index([senderId])
  @@index([messageType])
  @@index([systemEvent])
  @@index([isDeleted])
  @@index([deletedType])
  @@index([deletedAt])
  @@map("group_messages")
}

// -----------------------------------------------------------------------------
// GroupMember
// -----------------------------------------------------------------------------
model GroupMember {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId               String
  userId               String
  role                 String    @default("MEMBER")
  status               String    @default("ACTIVE")
  joinedAt             DateTime  @default(now())
  invitedBy            String?
  leftAt               DateTime?
  kickedAt             DateTime?
  kickedBy             String?
  kickReason           String?
  bannedAt             DateTime?
  bannedBy             String?
  lastReadMessageId    String?   @db.ObjectId
  lastReadAt           DateTime?
  unreadCount          Int       @default(0)
  notificationSettings Json      @default("{\"mute\": false, \"muteUntil\": null}")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([roomId, userId])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([roomId, status, role])
  @@index([role])
  @@map("group_members")
}

// -----------------------------------------------------------------------------
// GroupInviteLink
// -----------------------------------------------------------------------------
model GroupInviteLink {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String
  token     String    @unique
  createdBy String
  status    String    @default("ACTIVE")
  expiresAt DateTime?
  revokedAt DateTime?
  revokedBy String?
  maxUses   Int?
  usedCount Int       @default(0)
  shareName String    @default("")
  createdAt DateTime  @default(now())

  @@index([roomId, status, createdAt(sort: Desc)])
  @@map("group_invite_links")
}

// -----------------------------------------------------------------------------
// GroupMessagePin
// -----------------------------------------------------------------------------
model GroupMessagePin {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId            String
  messageId         String   @db.ObjectId
  pinnedBy          String
  pinnedAt          DateTime @default(now())
  messageCreatedAt  DateTime
  senderId          String
  senderDisplayName String   @default("")
  senderAvatar      String   @default("")
  contentPinned     Json     @default("{\"text\": \"\", \"urls\": [], \"files\": []}")

  @@unique([roomId, messageId])
  @@index([roomId, pinnedAt(sort: Desc)])
  @@map("group_message_pins")
}

// -----------------------------------------------------------------------------
// GeneralRoom
// -----------------------------------------------------------------------------
model GeneralRoom {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  owner            String?
  logo             String?
  title            String?
  desc             String?
  displayOrder     Int       @default(0)
  memberNumber     Int       @default(0)
  onlineNember     Int       @default(0)
  memberLimit      Int       @default(0)
  isLive           Boolean   @default(false)
  link             String?
  tags             String[]
  status           String    @default("active")
  lastMessageId    String?   @db.ObjectId
  lastMessageAt    DateTime?
  lastMessage      Json?
  listPinedMessage Json      @default("[]")
  pinnedCount      Int       @default(0)
  lastPinnedAt     DateTime?
  lastSequence     Int       @default(0)
  // PUBLIC | PRIVATE — the parent community's visibility, synced from
  // community-service. Drives non-member read access (PUBLIC history is
  // browsable by guests). null = unknown → treated as PRIVATE (fail-closed).
  communityType    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([tags])
  @@map("general_rooms")
}

// -----------------------------------------------------------------------------
// GeneralRoomMessage
// -----------------------------------------------------------------------------
model GeneralRoomMessage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId          String   @db.ObjectId
  sentBy          String
  senderName      String?
  senderAvatar    String?
  message         String?
  reactions       Json     @default("{}")
  parentMessageId String?  @db.ObjectId
  quoteData       Json?
  messageType     String   @default("text")
  attachments     Json     @default("[]")
  clientMessageId String?
  sequenceNumber  Int      @default(0)
  deletedBy       Json     @default("[]")
  deletedForAll   Boolean  @default(false)
  reports         Json     @default("[]")
  editedAt           DateTime?
  editHistory        Json     @default("[]")
  systemMessageType  String?
  systemMetadata     Json?
  // When set, this message is PERSONAL: visible ONLY to this userId (e.g. the
  // "You joined the community" onboarding message). null = visible to everyone
  // with room read access. Read paths filter on { $in: [null, requestingUserId] }.
  visibleToUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([roomId])
  @@index([roomId, sentBy])
  @@index([deletedForAll])
  @@index([roomId, messageType, createdAt(sort: Desc)])
  @@index([roomId, sequenceNumber])
  @@index([roomId, systemMessageType, createdAt(sort: Desc)])
  @@index([roomId, visibleToUserId, createdAt(sort: Desc)])
  @@map("general_room_messages")
}

// -----------------------------------------------------------------------------
// RoomMember (general/community rooms)
// -----------------------------------------------------------------------------
model RoomMember {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId   String
  userId   String
  status   String    @default("active")
  role     String    @default("member")
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  bannedAt DateTime?
  banInfo  Json?
  lastReadMessageId String?   @db.ObjectId
  lastReadAt        DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, userId])
  @@index([roomId, status])
  @@map("room_members")
}

// -----------------------------------------------------------------------------
// Notification
// -----------------------------------------------------------------------------
model Notification {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String
  actorId       String
  type          String
  entity        Json
  actorSnapshot Json
  payload       Json
  isRead        Boolean   @default(false)
  readAt        DateTime?
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type])
  @@index([isRead])
  @@index([isDeleted])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// Livestream
// -----------------------------------------------------------------------------
model Livestream {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId      String    @db.ObjectId
  title       String
  description String    @default("")
  thumbnail   String?
  scheduledAt DateTime?
  status      String    @default("SCHEDULED")
  livedAt     DateTime?
  tags        String[]
  servers     Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([roomId])
  @@map("livestreams")
}

// -----------------------------------------------------------------------------
// Friendship (local copy, eventually consistent with user-service)
// Synced via events: friendship.created, friendship.deleted, friendship.blocked
// Allows chat-service to operate independently without user-service gRPC calls
// -----------------------------------------------------------------------------
model Friendship {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  friendId  String
  status    String   @default("ACTIVE") // ACTIVE, BLOCKED, BANNED, PENDING
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, friendId])
  @@index([userId, status])
  @@index([friendId, status])
  @@map("friendships")
}

// -----------------------------------------------------------------------------
// Call
// -----------------------------------------------------------------------------
model Call {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  callId        String    @unique
  callerId      String
  calleeId      String
  type          String    @default("AUDIO")
  status        String    @default("RINGING")
  privateRoomId String?
  initiatedAt   DateTime  @default(now())
  answeredAt    DateTime?
  endedAt       DateTime?
  durationSec   Int?
  endedBy       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([callerId, initiatedAt(sort: Desc)])
  @@index([calleeId, initiatedAt(sort: Desc)])
  @@index([status])
  @@map("calls")
}

// -----------------------------------------------------------------------------
// PrivateMessageReport
// -----------------------------------------------------------------------------
model PrivateMessageReport {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId         String
  messageId      String   @db.ObjectId
  reporterId     String
  reportedUserId String
  reason         String
  description    String   @default("")
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([messageId, reporterId])
  @@index([status, createdAt(sort: Desc)])
  @@index([reportedUserId])
  @@map("private_message_reports")
}

// -----------------------------------------------------------------------------
// CommunityMessagePin
// -----------------------------------------------------------------------------
model CommunityMessagePin {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId            String
  messageId         String   @db.ObjectId
  pinnedBy          String
  pinnedAt          DateTime @default(now())
  messageCreatedAt  DateTime
  senderId          String
  senderDisplayName String   @default("")
  senderAvatar      String   @default("")
  contentPinned     Json     @default("{\"text\": \"\", \"urls\": [], \"files\": []}")

  @@unique([roomId, messageId])
  @@index([roomId, pinnedAt(sort: Desc)])
  @@map("community_message_pins")
}
