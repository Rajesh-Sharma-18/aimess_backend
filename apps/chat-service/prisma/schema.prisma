// =============================================================================
// chat-service  ·  MongoDB  ·  chat_db
// Owns: private messaging, group messaging, community rooms,
//       notifications, pins.
//       (Livestream comments are owned by stream-service.)
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}


datasource db {
  provider = "mongodb"
  // Required by the Prisma v6 CLI. Runtime PrismaClient overrides this via
  // datasourceUrl (composed from MONGO_* parts in src/config/env.ts), and
  // prisma.config.ts composes it for CLI commands.
  url      = env("MONGO_DATABASE_URL")
}

// -----------------------------------------------------------------------------
// PrivateRoom
// -----------------------------------------------------------------------------
model PrivateRoom {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId                    String   @unique
  participants              String[]
  participantsKey           String   @unique
  lastMessageId             String?  @db.ObjectId
  lastMessageAt             DateTime?
  lastMessage               Json?
  unreadCountByUser         Json     @default("{}")
  lastReadAtByUser          Json     @default("{}")
  lastReadMessageIdByUser   Json     @default("{}")
  hasUnreadByUser           Json     @default("{}")
  firstUnreadMessageIdByUser Json    @default("{}")
  lastUnreadMessageIdByUser Json     @default("{}")
  lastUnreadPreviewByUser   Json     @default("{}")
  blockedBy                 Json     @default("[]")
  deletedFor                Json     @default("{}")
  clearFor                  Json     @default("{}")
  mutedBy                   Json     @default("{}")
  archivedBy                Json     @default("{}")
  pinnedCount               Int      @default(0)
  lastPinnedAt              DateTime?
  lastSequence              Int      @default(0)
  // Zero-loss sync CHANGE cursor (Telegram `pts`). Per-room, strictly monotonic,
  // bumped on EVERY content change (insert, edit, delete-for-everyone, reaction) —
  // unlike `lastSequence`, bumped only on INSERT. Allocated via `allocateRevision`.
  lastRevision              Int      @default(0)
  // Reaction OVERLAY — mirrors community-service's Community.lastActivityReaction*
  // fields exactly (see that schema for the full rationale). Never overwrites
  // lastMessage/lastMessageAt (the canonical columns everyone else keeps reading);
  // visible ONLY to its own actor and (if different) the reacted-to message's
  // owner via a read-time gate (reactionActivityAt > lastMessageAt). Explicitly
  // cleared (all fields -> null) only when the SAME reaction (messageId+emoji+
  // actorId) is the one removed.
  reactionActivityAt            DateTime?
  reactionActivityMessageId     String?
  reactionActivityEmoji         String?
  reactionActivityActorId       String?
  reactionActivityActorPreview  String?
  reactionActivityTargetId      String?
  reactionActivityTargetPreview String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([participants])
  @@index([lastMessageAt(sort: Desc)])
  @@map("private_rooms")
}

// -----------------------------------------------------------------------------
// PrivateMessage
// -----------------------------------------------------------------------------
model PrivateMessage {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId           String
  senderId         String?
  receiverId       String?
  content          Json      @default("{\"text\": \"\", \"urls\": [], \"files\": []}")
  messageType      String    @default("TEXT")
  systemEvent      String?
  systemData       Json?
  countInUnread    Boolean?
  readBy           Json      @default("[]")
  reactions        Json      @default("{}")
  inviteLinkData   Json?
  parentMessageId  String?   @db.ObjectId
  quoteData        Json?
  clientInfo      Json?
  clientMessageId  String?
  isForwarded      Boolean   @default(false)
  forwardData      Json?
  deletedFor       Json      @default("{}")
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  deletedBy        String?
  sequenceNumber   Int       @default(0)
  // Zero-loss sync CHANGE cursor — the room's `lastRevision` at this message's most
  // recent state change. Immutable `sequenceNumber` fixes PLACEMENT; mutable `revision`
  // advances on every change so `/changes` can return an old message's current state
  // after an edit/delete/reaction. 0 = pre-backfill row.
  revision         Int       @default(0)
  createdAt        DateTime  @default(now())
  editedAt         DateTime?
  editHistory      Json      @default("[]")
  deliveredTo      Json      @default("[]")
  deliveredAt      Json      @default("{}")

  @@index([roomId, createdAt(sort: Desc)])
  // sequenceNumber trails createdAt so timestamp-paginated reads (findByRoomIdTimeline)
  // get a deterministic, index-backed total order with early-termination preserved.
  @@index([roomId, isDeleted, createdAt(sort: Desc), sequenceNumber(sort: Desc)])
  @@index([roomId, parentMessageId, createdAt(sort: Desc)])
  @@index([roomId, messageType, createdAt(sort: Desc)])
  @@index([roomId, sequenceNumber])
  // Backs the zero-loss CHANGES feed: WHERE roomId=? AND revision > ? ORDER BY revision ASC.
  // Tombstones must replay, so isDeleted is intentionally excluded from this index.
  @@index([roomId, revision])
  @@index([systemEvent])
  @@index([clientMessageId])
  @@map("private_messages")
}

// -----------------------------------------------------------------------------
// PrivateMessagePin
// -----------------------------------------------------------------------------
model PrivateMessagePin {
  id                       String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId                   String
  messageId                String    @db.ObjectId
  pinnedBy                 String
  pinnedAt                 DateTime  @default(now())
  unpinnedAt               DateTime? // null = ACTIVE; set = soft-deleted (unpinned) — parity with CommunityMessagePin
  unpinnedByUserId         String?
  originalMessageDeletedAt DateTime? // set when the pinned message is deleted for all
  pinSystemMessageId       String?   // ID of the MESSAGE_PINNED system message
  messageCreatedAt         DateTime
  senderId                 String
  senderDisplayName        String    @default("")
  senderAvatar              String   @default("")
  contentPinned            Json      @default("{\"text\": \"\", \"urls\": [], \"files\": []}")
  deletedFor               Json      @default("{}")

  // No @@unique — same message can be pinned/unpinned/repinned (soft-delete history), parity with Community
  @@index([roomId, messageId])
  @@index([roomId, unpinnedAt])       // active-pin lookup: WHERE roomId=X AND unpinnedAt IS NULL
  @@index([roomId, pinnedAt(sort: Desc)])
  @@index([roomId, messageCreatedAt(sort: Desc), pinnedAt(sort: Desc)])
  @@map("private_message_pins")
}

// -----------------------------------------------------------------------------
// GroupRoom
// -----------------------------------------------------------------------------
model GroupRoom {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId             String    @unique
  type               String    @default("GROUP")
  name               String
  // Formatting-insensitive shadow of `name` for search — see
  // `@aimess/utils` `normalizeForSearch` and `group-search.util.ts`.
  normalizedName     String    @default("")
  avatar             String    @default("")
  description        String    @default("")
  createdBy          String
  status             String    @default("ACTIVE")
  memberLimit        Int       @default(50)
  memberCount        Int       @default(1)
  settings           Json      @default("{\"allowMemberInviteLink\": true, \"allowMemberSendInviteLink\": true, \"allowReply\": true, \"allowPin\": true}")
  lastMessageId      String?   @db.ObjectId
  lastMessageAt      DateTime?
  lastMessagePreview Json?
  pinnedCount        Int       @default(0)
  lastPinnedAt       DateTime?
  lastSequence       Int       @default(0)
  // Zero-loss sync CHANGE cursor (Telegram `pts`) — see PrivateRoom.lastRevision.
  lastRevision       Int       @default(0)
  archivedBy         Json      @default("{}")
  disbandedAt        DateTime?
  disbandedBy        String?
  // Reaction OVERLAY — see PrivateRoom.reactionActivity* for the full rationale
  // (same fields, same read-time gate, same identity-matched clear).
  reactionActivityAt            DateTime?
  reactionActivityMessageId     String?
  reactionActivityEmoji         String?
  reactionActivityActorId       String?
  reactionActivityActorPreview  String?
  reactionActivityTargetId      String?
  reactionActivityTargetPreview String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([type])
  @@index([createdBy])
  @@index([status])
  @@index([memberCount])
  @@index([status, lastMessageAt(sort: Desc)])
  @@index([createdBy, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([normalizedName])
  @@index([status, memberCount(sort: Desc)])
  @@map("group_rooms")
}

// -----------------------------------------------------------------------------
// GroupMessage
// -----------------------------------------------------------------------------
model GroupMessage {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId             String
  clientMessageId    String?
  clientInfo         Json?
  senderId           String?
  senderName         String    @default("")
  senderAvatar       String    @default("")
  messageType        String    @default("TEXT")
  content            Json      @default("{\"text\": \"\", \"urls\": [], \"files\": []}")
  systemEvent        String?
  systemData         Json?
  countInUnread      Boolean?
  inviteLinkData     Json?
  parentMessageId    String?   @db.ObjectId
  quoteData          Json?
  reactions          Json      @default("{}")
  isForwarded        Boolean   @default(false)
  forwardData        Json?
  isDeleted          Boolean   @default(false)
  deletedType        String?
  deletedPlaceholder String    @default("")
  deletedAt          DateTime?
  deletedBy          String?
  deletedForUserIds  Json      @default("[]")
  // Message-level "Report" action, mirroring CommunityMessage's inline reports
  // array (as opposed to Private's dedicated PrivateMessageReport model).
  reports            Json      @default("[]")
  sequenceNumber     Int       @default(0)
  // Zero-loss sync CHANGE cursor — see PrivateMessage.revision. 0 = pre-backfill row.
  revision           Int       @default(0)
  // Members (userIds) whose socket the server has considered this message delivered
  // to — populated at send time from `PresenceService.getPresenceMany` and topped up
  // by the presence-connect backfill. Powers the group "at least one member online"
  // DELIVERED tier in the inbox tick without a new schema table.
  deliveredTo        Json      @default("[]")
  createdAt          DateTime  @default(now())
  editedAt           DateTime?
  editHistory        Json      @default("[]")

  // sequenceNumber trails createdAt so timestamp-paginated reads (findByRoomIdTimeline)
  // get a deterministic, index-backed total order with early-termination preserved.
  @@index([roomId, createdAt(sort: Desc), sequenceNumber(sort: Desc)])
  @@index([roomId, isDeleted, createdAt(sort: Desc)])
  @@index([roomId, parentMessageId, createdAt(sort: Desc)])
  @@index([roomId, messageType, createdAt(sort: Desc)])
  @@index([roomId, sequenceNumber])
  // Backs the zero-loss CHANGES feed — see PrivateMessage's equivalent index.
  @@index([roomId, revision])
  @@index([clientMessageId])
  @@index([senderId])
  @@index([messageType])
  @@index([systemEvent])
  @@index([isDeleted])
  @@index([deletedType])
  @@index([deletedAt])
  @@map("group_messages")
}

// -----------------------------------------------------------------------------
// GroupMember
// -----------------------------------------------------------------------------
model GroupMember {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId               String
  userId               String
  role                 String    @default("MEMBER")
  status               String    @default("ACTIVE")
  joinedAt             DateTime  @default(now())
  invitedBy            String?
  leftAt               DateTime?
  kickedAt             DateTime?
  kickedBy             String?
  kickReason           String?
  bannedAt             DateTime?
  bannedBy             String?
  // Moderator-imposed mute (distinct from `notificationSettings.mute`, which is
  // the member's OWN notification preference). A muted member keeps full read
  // access but cannot send/react — mirrors community's CommunityMemberMute,
  // collapsed onto this row since chat-service is already the sole source of
  // truth for group membership (no cross-service mirror needed here).
  // `moderationMutedUntil` null + `moderationMuted` true = indefinite.
  moderationMuted       Boolean   @default(false)
  moderationMutedUntil  DateTime?
  moderationMutedBy     String?
  // Per-user "delete conversation" cutoff (Telegram-style): messages created
  // at/before this instant are hidden from this member, even after new
  // messages restore the group to their inbox. Distinct from `leftAt` — the
  // member stays ACTIVE and keeps receiving new messages. See PrivateRoom.deletedFor.
  clearedAt            DateTime?
  clearChatAt          DateTime?
  lastReadMessageId    String?   @db.ObjectId
  lastReadAt           DateTime?
  unreadCount          Int       @default(0)
  notificationSettings Json      @default("{\"mute\": false, \"muteUntil\": null}")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([roomId, userId])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([roomId, status, role])
  @@index([role])
  @@map("group_members")
}

// -----------------------------------------------------------------------------
// GroupInviteLink
// -----------------------------------------------------------------------------
model GroupInviteLink {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String
  token     String    @unique
  createdBy String
  status    String    @default("ACTIVE")
  expiresAt DateTime?
  revokedAt DateTime?
  revokedBy String?
  maxUses   Int?
  usedCount Int       @default(0)
  shareName String    @default("")
  createdAt DateTime  @default(now())

  @@index([roomId, status, createdAt(sort: Desc)])
  @@map("group_invite_links")
}

// -----------------------------------------------------------------------------
// GroupMessagePin
// -----------------------------------------------------------------------------
model GroupMessagePin {
  id                       String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId                   String
  messageId                String    @db.ObjectId
  pinnedBy                 String
  pinnedAt                 DateTime  @default(now())
  unpinnedAt               DateTime? // null = ACTIVE; set = soft-deleted (unpinned) — parity with CommunityMessagePin
  unpinnedByUserId         String?
  originalMessageDeletedAt DateTime? // set when the pinned message is deleted for all
  pinSystemMessageId       String?   // ID of the MESSAGE_PINNED system message
  messageCreatedAt         DateTime
  senderId                 String
  senderDisplayName        String    @default("")
  senderAvatar             String    @default("")
  contentPinned            Json      @default("{\"text\": \"\", \"urls\": [], \"files\": []}")

  // No @@unique — same message can be pinned/unpinned/repinned (soft-delete history), parity with Community
  @@index([roomId, messageId])
  @@index([roomId, unpinnedAt])       // active-pin lookup: WHERE roomId=X AND unpinnedAt IS NULL
  @@index([roomId, pinnedAt(sort: Desc)])
  @@map("group_message_pins")
}

// -----------------------------------------------------------------------------
// GeneralRoom
// -----------------------------------------------------------------------------
model GeneralRoom {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  owner            String?
  logo             String?
  title            String?
  desc             String?
  displayOrder     Int       @default(0)
  memberNumber     Int       @default(0)
  onlineNember     Int       @default(0)
  memberLimit      Int       @default(0)
  isLive           Boolean   @default(false)
  link             String?
  tags             String[]
  status           String    @default("active")
  lastMessageId    String?   @db.ObjectId
  lastMessageAt    DateTime?
  lastMessage      Json?
  listPinedMessage Json      @default("[]")
  pinnedCount      Int       @default(0)
  lastPinnedAt     DateTime?
  lastSequence     Int       @default(0)
  // Zero-loss sync CHANGE cursor (Telegram `pts`). Per-room, strictly monotonic,
  // bumped on EVERY state change in the room (insert, edit, delete-for-all,
  // reaction change, pin/unpin, system message) — unlike `lastSequence`, which
  // is bumped only on message INSERT. Allocated via `allocateRevision`; each
  // allocation is stamped onto the mutated message's `revision`. See the
  // `/changes` feed + `community:catchup(sinceRevision)`.
  lastRevision     Int       @default(0)
  // PUBLIC | PRIVATE — the parent community's visibility, synced from
  // community-service. Drives non-member read access (PUBLIC history is
  // browsable by guests). null = unknown → treated as PRIVATE (fail-closed).
  communityType    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([tags])
  @@map("general_rooms")
}

// -----------------------------------------------------------------------------
// GeneralRoomMessage
// -----------------------------------------------------------------------------
model GeneralRoomMessage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId          String   @db.ObjectId
  sentBy          String
  senderName      String?
  senderAvatar    String?
  message         String?
  reactions       Json     @default("{}")
  parentMessageId String?  @db.ObjectId
  quoteData       Json?
  messageType     String   @default("text")
  attachments     Json     @default("[]")
  clientMessageId String?
  sequenceNumber  Int      @default(0)
  // Zero-loss sync CHANGE cursor — the room's `lastRevision` at the time of this
  // message's most recent state change (insert/edit/delete-for-all/reaction).
  // Immutable `sequenceNumber` fixes PLACEMENT; mutable `revision` advances to the
  // room's newest on every change so the `/changes` feed can return an old
  // message's current state after an edit/delete/reaction. 0 = pre-backfill row.
  revision        Int      @default(0)
  deletedBy       Json     @default("[]")
  deletedForAll   Boolean  @default(false)
  // Audit trail for delete-for-everyone, mirroring GroupMessage's deletedType/
  // deletedAt/deletedBy (a single actor id — NOT the same field as `deletedBy`
  // above, which is the per-user delete-FOR-ME list). "SELF_DELETE" when the
  // sender deleted their own message; "ADMIN_DELETE" for a moderator/admin
  // deleting someone else's.
  deletedForAllType String?
  deletedForAllAt   DateTime?
  deletedForAllBy   String?
  // Forward provenance, mirroring PrivateMessage/GroupMessage's isForwarded/
  // forwardData — previously absent, so a forwarded community message had no
  // record of its original message/room/sender despite the ForwardCommunity-
  // Message RPC and service method already existing.
  isForwarded     Boolean  @default(false)
  forwardData     Json?
  reports         Json     @default("[]")
  editedAt           DateTime?
  editHistory        Json     @default("[]")
  systemMessageType  String?
  systemMetadata     Json?
  countInUnread      Boolean?
  // When set, this message is PERSONAL: visible ONLY to this userId (e.g. the
  // "You joined the community" onboarding message). null = visible to everyone
  // with room read access. Read paths filter on { $in: [null, requestingUserId] }.
  visibleToUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([roomId])
  @@index([roomId, sentBy])
  @@index([deletedForAll])
  @@index([roomId, messageType, createdAt(sort: Desc)])
  // Backs the (createdAt, _id) keyset history page + countTimeline. Mongo uses
  // _id as the implicit trailing sort key, so this covers the timeline scan.
  @@index([roomId, createdAt(sort: Desc)])
  @@index([roomId, sequenceNumber])
  // Covering index for the V2 sequence history page (findByRoomIdSeq /
  // findAroundSeq): equality roomId + deletedForAll, range+sort sequenceNumber.
  // The plain [roomId, sequenceNumber] above does NOT cover the deletedForAll
  // equality the seq history $match adds, so without this the seq reads scan.
  @@index([roomId, deletedForAll, sequenceNumber])
  // Backs the zero-loss CHANGES feed + community:catchup(sinceRevision):
  // WHERE roomId=? AND revision > ? ORDER BY revision ASC. Tombstones are
  // intentionally NOT filtered by the changes query (a delete must replay), so
  // deletedForAll is excluded from this index — mirrors the updatedAt sync index.
  @@index([roomId, revision])
  @@index([roomId, systemMessageType, createdAt(sort: Desc)])
  @@index([roomId, visibleToUserId, createdAt(sort: Desc)])
  // Covering index for findByRoomIdTimeline (scroll/history): equality roomId +
  // deletedForAll, range+sort createdAt, sequenceNumber tiebreak. Desc/Desc serves
  // both before (desc) and after (asc, reverse scan) directions — index-backed sort
  // with early termination instead of a full-room blocking sort.
  @@index([roomId, deletedForAll, createdAt(sort: Desc), sequenceNumber(sort: Desc)])
  // Covering index for findUpdatedAtSince (incremental sync): roomId + updatedAt ASC,
  // sequenceNumber tiebreak. Tombstones are intentionally not filtered, so deletedForAll
  // is excluded here.
  @@index([roomId, updatedAt(sort: Asc), sequenceNumber(sort: Asc)])
  @@map("general_room_messages")
}

// -----------------------------------------------------------------------------
// RoomMember (general/community rooms)
// -----------------------------------------------------------------------------
model RoomMember {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId   String
  userId   String
  status   String    @default("active")
  role     String    @default("member")
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  bannedAt DateTime?
  banInfo  Json?
  // Moderation mute mirrored from community-service (community.member.mute_synced).
  // isMuted = community admin/mod silenced this member; mutedUntil = expiry (null
  // = indefinite while isMuted). The community-chat write-path gate checks these
  // locally — no per-message gRPC — with lazy expiry (mutedUntil <= now ⇒ lifted).
  isMuted    Boolean   @default(false)
  mutedUntil DateTime?
  lastReadMessageId String?   @db.ObjectId
  lastReadAt        DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, userId])
  @@index([roomId, status])
  @@map("room_members")
}

// -----------------------------------------------------------------------------
// Notification
// -----------------------------------------------------------------------------
model Notification {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String
  actorId       String
  type          String
  entity        Json
  actorSnapshot Json
  payload       Json
  isRead        Boolean   @default(false)
  readAt        DateTime?
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Mirrors payload.data.sessionId for "auth.security_new_login" rows only.
  // A scalar copy (not just the JSON blob) because MongoDB's Prisma JSON
  // `path` filter can't be combined with NOT/OR/AND — it only works as a bare
  // top-level predicate — so excluding "don't show a device its own login
  // alert" needs a real indexed field, not a JSON-path query.
  loginSessionId String?

  // Stable identity of the underlying entity/action (see lib/notification-identity.ts).
  // Two events for the same real-world thing share a groupKey, so the second one
  // transitions the existing row instead of creating a duplicate.
  groupKey String?
  // Monotonic per-row revision. Every mutation bumps it; clients apply an
  // incoming frame only when its version is >= the version they hold, which is
  // what makes socket/API/local-DB convergence order-independent.
  version Int @default(1)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type])
  // Covers the unread count — the hottest query here (every create, read,
  // delete and socket connect). The bare isRead/isDeleted indexes never
  // applied: every query is userId-scoped.
  @@index([userId, isRead, isDeleted])
  @@index([userId, loginSessionId])
  @@index([userId, groupKey])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// Livestream
// -----------------------------------------------------------------------------
model Livestream {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  roomId      String    @db.ObjectId
  title       String
  description String    @default("")
  thumbnail   String?
  scheduledAt DateTime?
  status      String    @default("SCHEDULED")
  livedAt     DateTime?
  tags        String[]
  servers     Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([roomId])
  @@map("livestreams")
}

// -----------------------------------------------------------------------------
// Friendship (local copy, eventually consistent with user-service)
// Synced via events: friendship.created, friendship.deleted, friendship.blocked
// Allows chat-service to operate independently without user-service gRPC calls
// -----------------------------------------------------------------------------
model Friendship {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  friendId  String
  status    String   @default("ACTIVE") // ACTIVE, BLOCKED, BANNED, PENDING
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, friendId])
  @@index([userId, status])
  @@index([friendId, status])
  @@map("friendships")
}

// -----------------------------------------------------------------------------
// Call
// -----------------------------------------------------------------------------
model Call {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  callId        String    @unique
  callerId      String
  // 1:1 calls: the single callee. Group calls: "" — the real roster lives in
  // calleeIds. Kept scalar (not nullable) rather than removed so every
  // existing 1:1 callerId/calleeId query stays a plain equality check.
  calleeId      String
  type          String    @default("AUDIO")
  status        String    @default("RINGING")
  privateRoomId String?
  // Set only for a GROUP call — the chat-service group roomId the call was
  // started from. null for 1:1 calls.
  groupId       String?
  // GROUP calls only: every rung member (excludes the caller). Empty for 1:1
  // calls, where calleeId alone is authoritative.
  calleeIds     String[]  @default([])
  initiatedAt   DateTime  @default(now())
  answeredAt    DateTime?
  endedAt       DateTime?
  durationSec   Int?
  endedBy       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([callerId, initiatedAt(sort: Desc)])
  @@index([calleeId, initiatedAt(sort: Desc)])
  @@index([groupId, status])
  @@index([status])
  // Busy-gate lookups filter by participant + status. ponytail: [status] alone
  // works at dev scale; these compound indexes keep the query cheap as call
  // volume grows.
  @@index([callerId, status])
  @@index([calleeId, status])
  // Admin call analytics scans a date range across ALL users (no participant
  // filter), so the participant-prefixed indexes above can't serve it.
  @@index([initiatedAt])
  @@map("calls")
}

// -----------------------------------------------------------------------------
// SystemFlag — platform-wide feature switches owned by chat-service.
// One row per flag, keyed by name (e.g. "calling.enabled"). Written by admins
// over gRPC (AdminSetCallingEnabled) and read on the hot path through a small
// TTL cache. Durable on purpose: a chat-service restart must not silently
// re-enable something an admin turned off.
// -----------------------------------------------------------------------------
model SystemFlag {
  key       String   @id @map("_id")
  enabled   Boolean
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("system_flags")
}

// -----------------------------------------------------------------------------
// PrivateMessageReport
// -----------------------------------------------------------------------------
model PrivateMessageReport {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId         String
  messageId      String   @db.ObjectId
  reporterId     String
  reportedUserId String
  reason         String
  description    String   @default("")
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([messageId, reporterId])
  @@index([status, createdAt(sort: Desc)])
  @@index([reportedUserId])
  @@map("private_message_reports")
}

// -----------------------------------------------------------------------------
// CommunityMessagePin
// -----------------------------------------------------------------------------
model CommunityMessagePin {
  id                       String    @id @default(auto()) @map("_id") @db.ObjectId
  communityId              String    @default("") // = roomId for general rooms (explicit for clarity)
  roomId                   String
  messageId                String    @db.ObjectId
  pinnedBy                 String
  pinnedAt                 DateTime  @default(now())
  unpinnedAt               DateTime? // null = ACTIVE; set = soft-deleted (unpinned)
  unpinnedByUserId         String?
  originalMessageDeletedAt DateTime? // set when the pinned message is deleted for all
  pinSystemMessageId       String?   // ID of the PINNED_MESSAGE GeneralRoomMessage
  messageCreatedAt         DateTime
  senderId                 String
  senderDisplayName        String    @default("")
  senderAvatar             String    @default("")
  contentPinned            Json      @default("{\"text\": \"\", \"urls\": [], \"files\": []}")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // No @@unique([roomId, messageId]) — same message can be pinned/unpinned/repinned (soft-delete history)
  @@index([roomId, messageId])
  @@index([roomId, unpinnedAt])       // active-pin lookup: WHERE roomId=X AND unpinnedAt IS NULL
  @@index([messageId])                // delete-message hook: find pins referencing a message
  @@index([roomId, pinnedAt(sort: Desc)])
  @@map("community_message_pins")
}
