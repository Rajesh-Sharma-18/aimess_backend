NODE_ENV=development
COMMUNITY_SERVICE_PORT=3003

# =========================
# MongoDB (Prisma db push reads prisma.config.ts)
# =========================
# Local single-node replica set rs0, no auth (see docker-compose mongodb). RS is
# required by Prisma's Mongo connector (transactions). directConnection=true so the
# host driver talks directly to the single node instead of doing RS discovery.
COMMUNITY_DATABASE_URL=mongodb://localhost:27018/community_db?directConnection=true

# =========================
# REDIS (availability caching)
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CACHE_ENABLED=true
# Community name/handle availability positive cache (seconds)
REDIS_CACHE_NAME_AVAIL_TTL_SEC=60
# Community name/handle taken negative cache (seconds)
REDIS_CACHE_NAME_TAKEN_TTL_SEC=86400

# =========================
# RabbitMQ (reserved for future community events)
# =========================
RABBITMQ_URL=amqp://aimess_rabbit:kKPF9jkbU6i2GGd@127.0.0.1:5673

# =========================
# JWT (same JWT_ACCESS_SECRET as auth-service / user-service)
# =========================
JWT_ACCESS_SECRET=

# =========================
# MinIO (S3-compatible community image storage)
# =========================
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
# Quote if password contains # (otherwise .env treats rest as comment)
MINIO_SECRET_KEY=
MINIO_BUCKET_COMMUNITY=aimess-community
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRES_IN=900
# Presigned GET for community image display (bucket private)
MINIO_IMAGE_VIEW_EXPIRES_IN=3600
# 5 MB default
COMMUNITY_IMAGE_MAX_UPLOAD_BYTES=5242880
