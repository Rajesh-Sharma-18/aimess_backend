NODE_ENV=development
COMMUNITY_SERVICE_PORT=3003
COMMUNITY_GRPC_PORT=4003

# chat-service gRPC endpoint â€” community-chat summaries (unread + last message)
# for GET /communities/mine. Defaults to 0.0.0.0:4004 if unset.
CHAT_GRPC_URL=0.0.0.0:4004
# stream-service gRPC endpoint â€” isLive enrichment + live stream list for communities.
STREAM_GRPC_URL=0.0.0.0:4007

# =========================
# MongoDB (Prisma db push reads prisma.config.ts)
# =========================
# Local single-node replica set rs0, no auth (see docker-compose mongodb). RS is
# required by Prisma's Mongo connector (transactions). directConnection=true so the
# host driver talks directly to the single node instead of doing RS discovery.
COMMUNITY_DATABASE_URL=mongodb://localhost:27018/community_db?directConnection=true

# =========================
# REDIS (availability caching)
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave EMPTY for a local unauthenticated Redis. REQUIRED for any shared or
# remote Redis (which must never be left open) — without it every command
# fails with NOAUTH.
REDIS_PASSWORD=
REDIS_CACHE_ENABLED=true
# Community name/handle availability positive cache (seconds)
REDIS_CACHE_NAME_AVAIL_TTL_SEC=60
# Community name/handle taken negative cache (seconds)
REDIS_CACHE_NAME_TAKEN_TTL_SEC=86400

# =========================
# RabbitMQ (reserved for future community events)
# =========================
RABBITMQ_URL=amqp://aimess_rabbit:kKPF9jkbU6i2GGd@127.0.0.1:5673

# =========================
# JWT (same JWT_ACCESS_SECRET as auth-service / user-service)
# =========================
JWT_ACCESS_SECRET=

# =========================
# MinIO (S3-compatible community image storage)
# =========================
MINIO_ENDPOINT=http://127.0.0.1:9000
# Client-facing MinIO host used to sign upload/view URLs (LAN IP in dev, CDN/public domain in prod).
# Leave blank to reuse MINIO_ENDPOINT (only works when the client is on the same machine).
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
# Quote if password contains # (otherwise .env treats rest as comment)
MINIO_SECRET_KEY=
MINIO_BUCKET_COMMUNITY=aimess-community
# user-service's avatars bucket (shared MinIO) â€” must match user-service MINIO_BUCKET_AVATARS
MINIO_BUCKET_AVATARS=aimess-avatars
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRES_IN=900
# Presigned GET for community image display (bucket private)
MINIO_IMAGE_VIEW_EXPIRES_IN=3600
# Presigned GET for member avatar display (bucket private)
MINIO_AVATAR_VIEW_EXPIRES_IN=3600
# 5 MB default
COMMUNITY_IMAGE_MAX_UPLOAD_BYTES=5242880

# =========================
# Invite-link abuse protection (per-user rate limits)
# =========================
# Max invite-link CREATE calls per user per rolling window
COMMUNITY_INVITE_CREATE_RATE_MAX=20
# Rolling window in seconds for invite-link CREATE rate limit
COMMUNITY_INVITE_CREATE_RATE_WINDOW_SEC=3600
# Max invite-link BULK-SEND calls per user per rolling window
COMMUNITY_INVITE_BULK_RATE_MAX=10
# Rolling window in seconds for invite-link BULK-SEND rate limit
COMMUNITY_INVITE_BULK_RATE_WINDOW_SEC=3600
# Max simultaneously-active invite links one member may own per community
COMMUNITY_INVITE_MAX_ACTIVE_LINKS_PER_MEMBER=20

USER_GRPC_URL=0.0.0.0:4002

# =========================
# Community sharing & deep linking (Sharing & Deep-Linking spec Â§9.5)
# =========================
# Canonical link base used to build share URLs server-side:
#   PRIVATE invite link  â†’ <base>/+<code>     (buildInviteUrl)
#   PUBLIC community      â†’ <base>/<handle>    (buildPublicShareUrl, by-handle resolver)
# Defaults to https://aimess.me when unset.
INVITE_LINK_BASE_URL=https://aimess.me

# Shared secret for service-to-service internal calls (the gateway's link-preview
# fetches the PUBLIC community OG card via GET /internal/communities/by-handle/:handle/card).
# MUST equal api-gateway INTERNAL_SHARED_SECRET. If unset, the internal endpoint 404s.
INTERNAL_SHARED_SECRET=

# =========================
# Internal gRPC service auth
# =========================
# Shared bearer token every service attaches to outgoing gRPC calls and
# validates on incoming ones. MUST be identical across ALL services.
# Unset + NODE_ENV=production => services refuse to start (fail fast rather
# than silently accepting anonymous internal calls). Unset in dev => auth is
# disabled with a startup warning.
GRPC_SERVICE_TOKEN=dev-grpc-service-token-change-me
