// =============================================================================
// community-service  ·  MongoDB  ·  community_db
// Owns: communities, categories, membership (+ future: posts, invites, reports).
//
// creatorId / adminId / userId here = auth-service AuthUser.id (UUID string,
// no FK across DBs / services).
//
// NOTE: the local Mongo runs as a SINGLE-NODE REPLICA SET (rs0) reached with
// directConnection=true (see docker-compose `mongod --replSet rs0`); production
// uses a managed RS. Prisma `$transaction` therefore WORKS here — an earlier
// version of this note claimed otherwise, which is why most write paths are
// sequential. Prefer a transaction whenever two collections must move together
// (see `reactivateMemberWithSnapshot` / `createMember` in the repository, which
// pair a membership write with its join-request resolution).
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("COMMUNITY_DATABASE_URL")
}

// -----------------------------------------------------------------------------
// CommunityCategory — curated list shown in the create-community picker.
// Seeded idempotently via prisma/seed/categories.seed.ts.
// -----------------------------------------------------------------------------
model CommunityCategory {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  slug        String  @unique
  // Optional admin-facing description; included in the admin list search
  // (name OR description) alongside name. Never shown to end users.
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)
  // Permanent soft-delete, same idiom as `Community.deletedAt` below: set when
  // an admin deletes a category that is still referenced by communities
  // (queried via `deletedAt: { isSet: false }`, never physically removed).
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  communities Community[]

  @@index([active, order])
  @@index([deletedAt])
  @@map("community_categories")
}

// -----------------------------------------------------------------------------
// Community — a public/private space owned by its creator.
// `handle` is the @Community-Name slug (unique); `name` is the display name.
// -----------------------------------------------------------------------------
model Community {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  name        String            
  handle      String            @unique
  // Formatting-insensitive search shadows of name/handle: lowercased with every
  // non-letter/digit character (spaces, underscores, hyphens, dots, other
  // punctuation) stripped — see `normalizeForSearch` in
  // `lib/community-search.util.ts`. Kept in sync by `createCommunity`/
  // `updateCommunity` in the repository whenever name/handle is written, so a
  // query like "dr_jhatka" or "dr.jhatka" matches a community named
  // "Dr. Jhatka" regardless of how either side is punctuated/spaced/cased.
  normalizedName   String        @default("")
  normalizedHandle String        @default("")
  description String?
  type        CommunityType     @default(PUBLIC)
  categoryId  String            @db.ObjectId
  category    CommunityCategory @relation(fields: [categoryId], references: [id])
  // Denormalized category display name, kept in sync on create + category change.
  // Exists ONLY to make the admin list sortable by category at the DB level —
  // Prisma's MongoDB connector can't `orderBy` the related category collection.
  // Optional so legacy rows (pre-denormalization) read cleanly until backfilled
  // (run `pnpm --filter @aimess/community-service db:backfill:category-name`).
  categoryName String?
  creatorId   String // AuthUser.id of the original creator
  adminId     String // AuthUser.id of the current admin/owner
  avatarUrl   String? // MinIO object key (community/avatar/{userId}/{uuid}.ext)
  coverUrl    String? // MinIO object key (community/cover/{userId}/{uuid}.ext)
  memberCount Int               @default(1)
  // Latest activity for inbox-style ordering: bumped to a community message's
  // timestamp (denormalized from chat-service via the community.activity event),
  // initialized to createdAt so message-less communities still sort by age.
  lastActivityAt       DateTime @default(now())
  lastActivityType     String?
  lastActivityPreview  String?
  lastActivityUsername String?
  lastActivityUserId   String?
  // Offline-first list identity of the message behind lastActivity*, denormalized
  // from the same `community.activity` event as the preview. Without these the
  // community list row carried a preview and a timestamp but no message identity,
  // so a client could not tell the server's copy of its own optimistic message
  // from a different message sent in the same millisecond, and could not order
  // two rows that tie on `lastActivityAt`. Nullable/0 for pre-backfill rows and
  // for lifecycle activity that has no client-originated message behind it.
  lastActivityMessageId       String?
  lastActivityClientMessageId String?
  lastActivitySeq             Int?
  /// UPPER-CASE canonical content type (TEXT/IMAGE/VOICE/…/SYSTEM).
  lastActivityContentType     String?
  // First-person ("You …") variant of lastActivityPreview for self-referential
  // SYSTEM lines (role change / join). When the viewer's id === lastActivityUserId
  // the list renders this instead of the third-person preview. Opaque string —
  // rendered by chat-service (single template source), never composed here.
  lastActivitySelfPreview String?
  // SYSTEM activity only — the canonical event + params the preview above was
  // rendered from (chat-service's `community.activity` carries the same pair
  // `community:message:new` does). The stored previews are baked in English at
  // write time and read by members in three languages, so the list row is
  // re-rendered from these per reader. Null for non-SYSTEM activity and for
  // rows written before this pair was carried — those keep their baked text.
  lastActivitySystemType     String?
  lastActivitySystemMetadata Json?
  // Reaction activity ("X reacted ❤️ to your message") is ABOUT two people at
  // once: the actor (lastActivityUserId/lastActivitySelfPreview above) AND the
  // reacted-to message's owner. This pair mirrors that same self-preview
  // pattern for the SECOND viewer — the target — so both the reactor and the
  // message owner see a personalized first-person line, while everyone else
  // falls back to lastActivityPreview (third-person). Null for every other
  // activity type. Opaque string, single template source in chat-service.
  lastActivityTargetUserId  String?
  lastActivityTargetPreview String?
  // Reaction OVERLAY — fully independent of the canonical lastActivity* fields
  // above. Reactions never write lastActivityAt/Type/Preview/Username/UserId
  // (so a message/system event is ALWAYS what everyone else sees — a reaction
  // can never overwrite what the rest of the community reads). This overlay
  // represents ONLY the single most-recently-ADDED still-active reaction
  // system-wide, visible ONLY to its own actor and (if different) the
  // reacted-to message's owner; every other viewer always falls back to the
  // canonical columns. Read-time gate: only shown when
  // lastActivityReactionAt is strictly newer than lastActivityAt (a genuinely
  // newer message/system event silently supersedes a stale reaction with no
  // explicit clear needed). Explicitly cleared (all fields → null) only when
  // the SPECIFIC reaction identified by
  // (lastActivityReactionMessageId, lastActivityReactionEmoji,
  // lastActivityReactionActorId) is removed — removing a DIFFERENT reaction
  // (same message, other emoji/user, or a different message entirely) is a
  // no-op here, since that reaction was never the one being shown.
  lastActivityReactionAt            DateTime?
  lastActivityReactionMessageId     String?
  lastActivityReactionEmoji         String?
  lastActivityReactionActorId       String?
  lastActivityReactionActorPreview  String?
  lastActivityReactionTargetId      String?
  lastActivityReactionTargetPreview String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  // Admin moderation state. DISTINCT from `deletedAt`: moderationStatus is an
  // admin/backoffice "Close" (SUSPENDED) toggle, whereas `deletedAt` below is a
  // user-initiated soft-delete. The two are independent — a community can be
  // SUSPENDED without being deleted, and vice versa.
  moderationStatus CommunityModerationStatus @default(ACTIVE)
  closedAt         DateTime? // when an admin suspended/closed the community
  closedReasonCode String? // CloseReasonCode from backoffice-service
  closedByAdminId  String? // backoffice AdminUser.id who closed it
  // Owner-controlled lifecycle status — DISTINCT from `moderationStatus` (platform
  // SUSPENDED) and `deletedAt` (permanent soft-delete). CLOSED is a reversible
  // "owner closed this community" state: all members are auto-removed and the
  // community is read-only until the owner reopens it. Absent ⇒ ACTIVE
  // (backward-compat for legacy rows; backfilled by db:backfill:status).
  status            CommunityStatus @default(ACTIVE)
  statusClosedAt    DateTime? // when the owner CLOSED it (status axis)
  statusClosedBy    String? // community AuthUser.id (admin/owner) who closed it
  statusClosedReason String? // optional free-text reason supplied by the owner
  // Machine-readable cause of the close. "ADMIN_BANNED" = the owner was
  // permanently system-banned; such a close outlives the ban (reopenCommunity
  // refuses it) and is surfaced to clients as status CLOSED_BY_SYSTEM_BAN.
  statusClosedReasonCode String?
  deletedAt   DateTime?
  // Permanent invitation code for PRIVATE communities — generated once, never
  // rotated unless an admin explicitly requests regeneration (future feature).
  // Stored on the community (not in CommunityInviteLink) because it is a
  // singleton community property, not an admin-managed expiring link.
  // A sparse unique index is created at startup (see server.ts) because Prisma
  // cannot express sparse indexes for MongoDB — a standard @unique on a nullable
  // field would prevent multiple communities from having null simultaneously.
  invitationCode          String?
  invitationCodeCreatedAt DateTime?
  members     CommunityMember[]

  @@index([categoryId])
  @@index([creatorId])
  // Backs the owner lookup used by the system-ban cascade (findCommunityIdsByAdminId).
  @@index([adminId])
  @@index([lastActivityAt])
  @@index([moderationStatus, createdAt])
  @@index([status, createdAt])
  // Backs the admin list's category-name sort (orderBy categoryName, _id tiebreak).
  @@index([categoryName])
  // Backs the admin user→communities list's name sort (orderBy name, _id tiebreak).
  @@index([name])
  // Formatting-insensitive search: these can't accelerate an arbitrary
  // mid-string `contains` (Mongo can only index-optimize a left-anchored
  // regex), but DO speed up prefix-style lookups and keep the fields easy to
  // find/inspect. See the "Performance considerations" note on
  // `normalizeForSearch`/`buildCommunitySearchFilter` for the full picture.
  @@index([normalizedName])
  @@index([normalizedHandle])
  // Backs fast lookup by permanent invitation code (lookupInviteLink fallback).
  // The sparse unique variant of this index is created at startup; this entry
  // documents intent but the actual enforcement is in server.ts.
  @@index([invitationCode])
  @@map("communities")
}

// -----------------------------------------------------------------------------
// CommunityMember — membership row. userId = AuthUser.id.
// -----------------------------------------------------------------------------
model CommunityMember {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  communityId String                @db.ObjectId
  community   Community             @relation(fields: [communityId], references: [id])
  userId              String // AuthUser.id
  snapshotUsername    String
  snapshotDisplayName String
  snapshotAvatarKey   String?
  role        CommunityMemberRole   @default(MEMBER)
  status      CommunityMemberStatus @default(ACTIVE)
  bannedAt    DateTime?
  bannedBy    String?
  banReason   String?
  // Admin/moderator kick marker — status stays LEFT (same as a voluntary leave,
  // so every existing rejoin-flow "reactivate a LEFT row" check keeps working
  // unmodified), but a non-null removedAt distinguishes an admin kick from a
  // genuine voluntary leave. AUDIT METADATA ONLY — a kicked member is treated
  // exactly like a voluntary leave everywhere (not visible in their list, no
  // access, normal rejoin flow). Mirrors the bannedAt/bannedBy pair. Cleared
  // on rejoin.
  removedAt   DateTime?
  removedBy   String?
  removedReason String?
  // "User hid this BANNED community from their own list" flag. A ban keeps the
  // community visible in the target's list until THEY dismiss it; dismissing
  // sets this WITHOUT touching status/ban metadata (the ban must survive —
  // only an admin unban lifts it, which also unsets this so a future re-ban is
  // visible again). Follows the deletedAt idiom: set a Date, `unset` to clear,
  // filter with `{ isSet: false }` (never explicit null).
  dismissedAt DateTime?
  // Set when an admin unbans this member (status flips BANNED -> LEFT, same as
  // any other non-member — no access, must rejoin through the normal flow).
  // Distinguishes THIS specific LEFT (unban, community stays in the target's
  // list until they dismiss it) from an ordinary voluntary leave or kick
  // (LEFT, never visible — normal preview + join flow, no special-casing).
  // Cleared on rejoin (reactivateMemberWithSnapshot) and on a future re-ban
  // (updateMemberStatus's resetRole/ban write), so it never leaks into an
  // unrelated later LEFT transition.
  unbannedAt DateTime?
  joinedAt    DateTime              @default(now())
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([communityId, userId])
  @@index([userId, status])
  @@index([communityId, status])
  // Backs the admin member list's handle sort (orderBy snapshotUsername within a
  // community); the exclusion + role/search filter is covered by [communityId, status].
  @@index([communityId, status, snapshotUsername])
  // Banned-members list: default sort is bannedAt within [communityId, status=BANNED];
  // also backs the admin member list's username (display name) sort.
  @@index([communityId, status, bannedAt])
  @@index([communityId, status, snapshotDisplayName])
  // "My list" query: status=ACTIVE OR (status=BANNED AND dismissedAt unset)
  // OR (status=LEFT AND unbannedAt set AND dismissedAt unset).
  @@index([userId, status, dismissedAt])
  @@index([userId, status, unbannedAt, dismissedAt])
  @@map("community_members")
}

// -----------------------------------------------------------------------------
// CommunityAuditLog — append-only moderation trail (promote/demote, kick, ban,
// unban, admin transfer). `communityId` is a plain ObjectId scalar (no relation
// field needed); actorId / targetUserId = AuthUser.id. ObjectId is time-ordered,
// so newest-first ordering uses `id` desc and cursor pagination keys on `id`.
// -----------------------------------------------------------------------------
model CommunityAuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  communityId  String   @db.ObjectId
  actorId      String // AuthUser.id who performed the action
  action       String // see CommunityAuditAction union in code
  targetUserId String? // member acted upon (if any)
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now())

  // Query filters by communityId and orders by `id` desc (ObjectId is
  // time-ordered) with cursor pagination on `id` — so a plain communityId index
  // backs the filter and the PK `_id` index serves the sort.
  @@index([communityId])
  @@map("community_audit_logs")
}

// -----------------------------------------------------------------------------
// Join requests / invites (gated communities).
// -----------------------------------------------------------------------------
model CommunityJoinRequest {
  id          String                 @id @default(auto()) @map("_id") @db.ObjectId
  communityId String                 @db.ObjectId
  userId      String
  status      CommunityJoinReqStatus @default(PENDING)
  message     String?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([communityId, userId])
  @@index([communityId, status])
  @@map("community_join_requests")
}

model CommunityInvite {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  communityId String                @db.ObjectId
  inviterId   String
  inviteeId   String
  status      CommunityInviteStatus @default(PENDING)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([communityId, inviteeId])
  @@index([inviteeId, status])
  @@map("community_invites")
}

// -----------------------------------------------------------------------------
// CommunityReport — moderation reports against a community OR a specific member.
// targetUserId null → report is against the community itself.
// Reporter/target/reviewer ids = AuthUser.id (UUID).
//
// Duplicate-report enforcement for member-targeted reports (a reporter may
// report the same target user only once per community, regardless of
// status): enforced at the SERVICE level (community.repository.ts
// findReportByReporterAndTarget(), checked in community.service.ts
// createReport() against ALL statuses) AND at the DB level via a partial
// unique index on (communityId, reporterId, targetUserId), created
// idempotently in server.ts (`community_reports_reporter_target_unique`).
// No plain `@@unique` here because targetUserId is optional/nullable:
// MongoDB unique indexes treat an explicit null the same across documents,
// so a non-partial unique index would also collide across every
// community-level (no-target) report from the same reporter — which must
// remain unrestricted. Prisma's MongoDB connector cannot express a
// partial/filtered index in schema.prisma, hence the raw `$runCommandRaw`
// in server.ts instead of a `@@unique` here.
// -----------------------------------------------------------------------------
model CommunityReport {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  communityId  String                @db.ObjectId
  reporterId   String
  targetUserId String?
  reason       String
  // Mandatory free-text description when `reason` is the custom "OTHER"
  // category; null for every predefined reason. Stored separately so `reason`
  // itself is never overwritten with the reporter's free text.
  otherReason  String?
  status       CommunityReportStatus @default(OPEN)
  reviewedBy   String?
  reviewedAt   DateTime?
  resolution   String?

  // --- Reported-content snapshot (optional; all null for user-level reports) ---
  // Captured by the client at report time so the moderator card survives a later
  // edit/delete of the original message and avoids a cross-service read.
  // `reportedContentMedia` stores RAW object keys only — resolved to presigned
  // URLs on read (never persist a resolved URL).
  reportedMessageId       String?
  reportedContentType     String? // CONTENT_TYPES (UPPER): TEXT, IMAGE, VIDEO, ...
  reportedContentText     String? // text / caption snapshot
  reportedContentMedia    Json? // [{ objectKey, contentType?, fileName?, size? }]
  reportedContentPostedAt DateTime? // when the reported content was originally posted

  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([communityId, status])
  @@index([reporterId, status])
  @@map("community_reports")
}

// -----------------------------------------------------------------------------
// CommunityMuteSetting — per-user per-community notification mute. `mutedUntil`
// null → muted indefinitely; future Date → muted until that timestamp; row
// absent → not muted. Lazy expiration (no janitor).
// -----------------------------------------------------------------------------
model CommunityMuteSetting {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String // AuthUser.id
  communityId         String    @db.ObjectId
  mutedUntil          DateTime?
  streamEnabled       Boolean   @default(true)
  chatEnabled         Boolean   @default(true)
  announcementEnabled Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, communityId])
  @@index([userId])
  @@map("community_mute_settings")
}

// -----------------------------------------------------------------------------
// CommunityMemberMute — moderation mute applied to a member by a moderator/admin
// (distinct from the per-user notification mute CommunityMuteSetting).
// `mutedUntil` null → muted indefinitely; future Date → muted until that
// timestamp; row absent → not muted. Lazy expiration (no janitor).
// -----------------------------------------------------------------------------
model CommunityMemberMute {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  communityId String    @db.ObjectId
  userId      String // AuthUser.id of the muted member
  mutedBy     String // AuthUser.id of the moderator/admin
  reason      String?
  mutedUntil  DateTime? // null = indefinite
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([communityId, userId])
  @@index([communityId])
  @@map("community_member_mutes")
}

// -----------------------------------------------------------------------------
// CommunityMemberWarning — moderation warning issued to a member, with a note.
// Append-only (multiple warnings per member).
// -----------------------------------------------------------------------------
model CommunityMemberWarning {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  communityId String   @db.ObjectId
  userId      String // AuthUser.id of the warned member
  warnedBy    String // AuthUser.id of the moderator/admin
  note        String
  createdAt   DateTime @default(now())

  @@index([communityId, userId])
  @@map("community_member_warnings")
}

// -----------------------------------------------------------------------------
// CommunityInviteLink — shareable join link (distinct from 1:1 CommunityInvite).
// `code` is server-generated, URL-safe; revoked / expired / exhausted is computed
// at redeem time. Atomic conditional-update guards against over-redemption.
// -----------------------------------------------------------------------------
model CommunityInviteLink {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  code        String    @unique
  communityId String    @db.ObjectId
  createdBy   String // AuthUser.id of issuer
  maxUses     Int?
  usedCount   Int       @default(0)
  autoApprove Boolean   @default(false)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([communityId, revokedAt])
  @@map("community_invite_links")
}

// -----------------------------------------------------------------------------
// CommunityFavorite — user bookmarks/likes a community. Any authenticated user
// may like a community regardless of membership. Unique per (userId, communityId).
// -----------------------------------------------------------------------------
model CommunityFavorite {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   // AuthUser.id
  communityId String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([userId, communityId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("community_favorites")
}

// =============================================================================
// Enums
// =============================================================================

enum CommunityType {
  PUBLIC
  PRIVATE
}

// Admin moderation state set from backoffice-service. SUSPENDED == admin "Closed"
// in the admin panel. Distinct from `Community.deletedAt` (user soft-delete).
enum CommunityModerationStatus {
  ACTIVE
  SUSPENDED
}

// Owner-controlled community lifecycle status. CLOSED is a reversible
// "owner closed this community" state (all members auto-removed, read-only)
// — distinct from platform moderation (`moderationStatus=SUSPENDED`) and from
// permanent deletion (`deletedAt`). Absent on legacy rows ⇒ treat as ACTIVE.
enum CommunityStatus {
  ACTIVE
  CLOSED
}

enum CommunityMemberRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityMemberStatus {
  ACTIVE
  PENDING
  BANNED
  LEFT
}

enum CommunityJoinReqStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  // The requester became a member through a path OTHER than this request being
  // approved (admin Add Member, invite accept, invite-link redeem, public
  // self-join). Written in the SAME transaction as the membership row, so a
  // current member can never hold a PENDING request. Distinct from APPROVED
  // (the admin acted on the request) and CANCELLED (the user withdrew it), so
  // the audit trail and the system-message copy stay truthful.
  AUTO_RESOLVED
}

enum CommunityInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum CommunityReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
  WITHDRAWN
}
