NODE_ENV=development
BACKOFFICE_SERVICE_PORT=3010
BACKOFFICE_GRPC_PORT=4010

# =========================
# POSTGRES (admin_db) — Prisma migrate reads prisma.config.ts
# =========================
ADMIN_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admin_db"

# =========================
# REDIS
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379

# =========================
# ADMIN JWT (separate secret from the user-facing access token)
# =========================
# Access token (8h) + refresh token (7d). Expiry values are in SECONDS.
JWT_ADMIN_SECRET=
# Optional separate secret for admin refresh tokens. Falls back to JWT_ADMIN_SECRET when unset.
JWT_ADMIN_REFRESH_SECRET=
JWT_ADMIN_EXPIRES_IN=28800
JWT_ADMIN_REFRESH_EXPIRES_IN=604800

# =========================
# RabbitMQ
# =========================
RABBITMQ_URL=

# =========================
# gRPC endpoints for dashboard aggregation (live, read-only)
# =========================
AUTH_GRPC_URL=0.0.0.0:4001
# user-service gRPC — enriches the admin user list/detail with username + avatar
USER_GRPC_URL=0.0.0.0:4002
COMMUNITY_GRPC_URL=0.0.0.0:4003
CHAT_GRPC_URL=0.0.0.0:4004
# stream-service gRPC — AdminListStreams/AdminGetStream for the livestream admin panel
STREAM_GRPC_URL=0.0.0.0:4007

# =========================
# Admin edge controls
# =========================
# Comma-separated CORS origin allowlist (e.g. the admin-panel URL). LAN/loopback
# origins are auto-allowed in dev; set production hosts here. Empty is fine in dev.
CORS_ALLOWED_ORIGINS=
# Empty = allow all (dev). Comma-separated IPs otherwise. Enforced at gateway too.
ADMIN_IP_WHITELIST=
TRUST_PROXY_HOPS=0
ADMIN_RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_RATE_LIMIT_MAX=100
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# =========================
# Bootstrap super-admin (seed). Leave unset to skip auto-creation.
# Password must be >= 12 chars. Never commit a real password.
# =========================
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin

# =========================
# Admin password reset (OTP + reset token)
# =========================
# OTP digit length, time-to-live, and per-row attempt cap.
ADMIN_OTP_LENGTH=6
ADMIN_OTP_TTL_SECONDS=300
ADMIN_OTP_MAX_ATTEMPTS=5
# Issuance throttle (per email + per IP) over a sliding window.
ADMIN_OTP_REQUEST_MAX=5
ADMIN_OTP_REQUEST_WINDOW_SEC=900
# Minimum seconds between resend-otp requests for the same email.
ADMIN_OTP_RESEND_COOLDOWN_SEC=60
# Reset-token (issued after OTP verify) lifetime in seconds.
ADMIN_PASSWORD_RESET_TOKEN_TTL_SECONDS=600
# Dev-only fixed OTP to skip email delivery while testing. Leave unset in prod.
ADMIN_OTP_DEV_FIXED_CODE=

# =========================
# SMTP — OTP email delivery for forgot-password / admin onboarding.
# SMTP_PASS must be a Google App Password (not your login password) when using Gmail.
# Leave host=localhost port=1025 to use MailHog in local dev (no real email sent).
# =========================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AIMess Admin <no-reply@aimess.local>

# =========================
# Admin avatars
# =========================
# Base URL of the default-avatar generator used when an admin has no custom
# avatar. A deterministic `?seed=<admin>` is appended. Defaults to DiceBear's
# keyless initials service; override with an internal CDN/generator in prod.
ADMIN_DEFAULT_AVATAR_BASE_URL=https://api.dicebear.com/9.x/initials/svg

# =========================
# MinIO (S3-compatible) — SHARED avatars bucket, presign-only
# =========================
# User avatars are produced by user-service; backoffice only signs short-lived
# GET URLs so the admin panel can render them. Use the SAME values as
# user-service / community-service.
MINIO_ENDPOINT=http://127.0.0.1:9000
# Client-facing MinIO host used to sign view URLs (LAN IP in dev, CDN/public
# domain in prod). Leave blank to reuse MINIO_ENDPOINT (same-machine setups).
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_AVATARS=aimess-avatars
# Community avatar/cover bucket (community-service owns the keys; backoffice only
# signs view URLs so admin community detail returns a full cover URL, not a key).
MINIO_BUCKET_COMMUNITY=aimess-community
# Stream thumbnails bucket — backoffice issues presigned PUT URLs for admin uploads.
MINIO_BUCKET_STREAM=aimess-stream
MINIO_REGION=us-east-1
# Presigned GET lifetime for avatar display URLs (seconds).
MINIO_AVATAR_VIEW_EXPIRES_IN=3600
# Presigned PUT lifetime for stream thumbnail admin uploads (seconds).
MINIO_STREAM_THUMBNAIL_UPLOAD_EXPIRES_IN=300
