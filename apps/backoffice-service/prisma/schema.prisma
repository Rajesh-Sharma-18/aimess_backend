// =============================================================================
// backoffice-service  ·  PostgreSQL  ·  admin_db
// Owns: admin identity, RBAC, admin sessions, audit logs, moderation trail,
//       system settings, announcements (i18n), and event-fed read-models.
// Does NOT own: any other service's domain data — referenced by shared ID only
//               (no cross-DB FK). See docs/ADMIN-SERVICE-DESIGN.md §4.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminStatus {
  ACTIVE
  DISABLED
  INVITED
  // Soft-delete: the row is kept (audit trail, FK integrity) but the account
  // is permanently gone. Distinct from DISABLED so auth flows can tell
  // "temporarily deactivated" apart from "no longer exists".
  DELETED
}

enum AdminOtpPurpose {
  PASSWORD_RESET
}

enum RoleKey {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT_AGENT
  ANALYST
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

// -----------------------------------------------------------------------------
// Identity & RBAC
// -----------------------------------------------------------------------------
model AdminUser {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String
  name         String
  // Custom avatar URL set via the admin profile. null = use the system-generated
  // default avatar (resolved on read in lib/admin-avatar.ts), never stored.
  avatarUrl    String?
  // Preferred admin-panel UI language ("en" | "th" | "vi"). null = never chosen,
  // the client keeps using its own stored/browser locale.
  language     String?
  roleId       String      @db.Uuid
  role         AdminRole   @relation(fields: [roleId], references: [id])
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?   @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  sessions            AdminSession[]
  otpCodes            AdminOtpCode[]
  passwordResetTokens AdminPasswordResetToken[]
  permissionOverrides AdminPermissionOverride[]

  @@index([roleId])
}

// -----------------------------------------------------------------------------
// Admin password-reset (OTP + reset token)
// -----------------------------------------------------------------------------
model AdminOtpCode {
  id          String          @id @default(uuid()) @db.Uuid
  adminId     String          @db.Uuid
  admin       AdminUser       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  identifier  String // normalized lowercase email
  purpose     AdminOtpPurpose
  codeHash    String // bcrypt hash, never plaintext
  attempts    Int             @default(0)
  maxAttempts Int             @default(5)
  expiresAt   DateTime        @db.Timestamptz(3)
  consumedAt  DateTime?       @db.Timestamptz(3)
  ip          String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  @@index([identifier, purpose, consumedAt])
  @@index([adminId, purpose])
  @@index([expiresAt])
}

model AdminPasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  adminId    String    @db.Uuid
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([adminId])
  @@index([expiresAt])
}

model AdminRole {
  id          String  @id @default(uuid()) @db.Uuid
  key         RoleKey @unique
  name        String
  description String?

  permissions RolePermission[]
  admins      AdminUser[]
}

model Permission {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique // e.g. "users.moderate"
  group String // "users" | "reports" | ...

  roles          RolePermission[]
  adminOverrides AdminPermissionOverride[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       AdminRole  @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])
  scope      Json? // optional resource scope (e.g. { communityIds: [...] })

  @@id([roleId, permissionId])
}

// Per-admin DELTA on top of the role baseline — never a snapshot of it.
// Effective = role's keys UNION allow-rows MINUS deny-rows, so a later change to
// the role matrix still propagates everywhere a human hasn't explicitly overridden.
// The composite PK makes a contradictory allow+deny pair unrepresentable.
model AdminPermissionOverride {
  adminId      String     @db.Uuid
  permissionId String     @db.Uuid
  admin        AdminUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id])
  allow        Boolean // true = grant on top of role, false = revoke from role
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  @@id([adminId, permissionId])
  @@index([adminId])
}

model AdminSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminId          String    @db.Uuid
  admin            AdminUser @relation(fields: [adminId], references: [id])
  refreshTokenHash String    @unique
  refreshExpiresAt DateTime  @db.Timestamptz(3)
  rotatedToId      String?   @unique @db.Uuid
  ip               String
  userAgent        String?
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([adminId])
}

// -----------------------------------------------------------------------------
// Audit
// -----------------------------------------------------------------------------
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  // AdminUser.id when actorType=ADMIN, AuthUser.id when actorType=USER, null for SYSTEM.
  // Intentionally NOT a relation: end-user ids live in another service's database, so a
  // foreign key to AdminUser would reject every website-side row.
  actorId    String? @db.Uuid
  actorType  AuditActorType @default(ADMIN)
  action     String // "user.ban", "community.member_joined", ...
  targetType String // "user" | "community" | "group" | "stream" | "settings" | "admin"
  targetId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  // Publisher-side idempotency key for ingested website activity; null for admin-written rows.
  eventId    String?  @unique
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([actorType, createdAt])
}

enum AuditActorType {
  ADMIN
  USER
  SYSTEM
}

// -----------------------------------------------------------------------------
// Moderation trail (admin side of truth)
// -----------------------------------------------------------------------------
model ModerationAction {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  type       String // ban_user | suspend_user | suspend_community | delete_content | force_end_stream
  targetType String
  targetId   String
  reason     String
  metadata   Json?
  reportId   String?   @db.Uuid // links to Report when action came from queue (future)
  expiresAt  DateTime? @db.Timestamptz(3) // when a time-boxed action (suspend) lapses
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([targetType, targetId])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([reportId, createdAt(sort: Desc)])
}

// -----------------------------------------------------------------------------
// System settings
// -----------------------------------------------------------------------------
model SystemSetting {
  key         String   @id // "feature.reports.enabled", "maintenance.banner"
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

// -----------------------------------------------------------------------------
// Announcements
// -----------------------------------------------------------------------------
enum AnnouncementTarget {
  ALL
  COMMUNITY
}

enum AnnouncementStatus {
  SCHEDULED // has a future scheduledAt, waiting for the poller
  PROCESSING // claimed for delivery, batches are being enqueued
  SENT // all batches enqueued successfully
  FAILED // delivery exhausted retries
}

enum AnnouncementKind {
  ANNOUNCEMENT
  MAINTENANCE
  UPDATE_REQUIRED
}

model Announcement {
  id             String             @id @default(uuid()) @db.Uuid
  title          String
  description    String
  target         AnnouncementTarget
  kind           AnnouncementKind   @default(ANNOUNCEMENT)
  communityId    String?            @db.Uuid // required iff target == COMMUNITY
  status         AnnouncementStatus @default(SCHEDULED)
  scheduledAt    DateTime?          @db.Timestamptz(3) // null = deliver immediately
  recipientCount Int                @default(0)
  failureReason  String?
  createdById    String             @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  sentAt         DateTime?          @db.Timestamptz(3)

  @@index([status, scheduledAt]) // poller claim query
  @@index([target, status]) // list filter
  @@index([createdAt(sort: Desc)])
  @@index([communityId])
}

// -----------------------------------------------------------------------------
// Read-models (event-fed; eventually consistent)
// -----------------------------------------------------------------------------
model PlatformStats {
  id               String   @id @default("singleton")
  totalUsers       Int      @default(0)
  newUsersToday    Int      @default(0)
  bannedUsers      Int      @default(0)
  totalCommunities Int      @default(0)
  totalGroups      Int      @default(0)
  totalLivestreams Int      @default(0) // STATIC for now
  openReports      Int      @default(0) // STATIC for now
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
}

model DailyActiveSnapshot {
  date          DateTime @id @db.Date
  dailyActive   Int
  monthlyActive Int
  churned       Int
  newUsers      Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
}

model CommunityIndex {
  id          String   @id // community id (shared)
  name        String
  ownerId     String
  memberCount Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
}

// UNUSED read-model placeholder — never written, never read. Group Management is
// live-over-gRPC (group.grpc.repository.ts). Do NOT assume this table is populated.
model GroupIndex {
  id          String   @id
  name        String
  ownerId     String
  memberCount Int      @default(0)
  status      String   @default("active")
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
}

// Merged user read-model backing the admin User Management API. Seeded/backfilled
// for now; event consumers (admin.user_* are published BY this service) and
// auth/user-service projections will populate it later. NOT the source of truth
// for account state — auth-service AuthUser is. We mirror status here for queries.
model UserIndex {
  userId         String     @id // shared id == AuthUser.id (UUID, no cross-DB FK)
  username       String
  email          String
  status         UserStatus @default(ACTIVE)
  reportCount    Int        @default(0)
  joinedAt       DateTime   @db.Timestamptz(3)
  lastActiveAt   DateTime?  @db.Timestamptz(3)
  bannedAt       DateTime?  @db.Timestamptz(3)
  banReason      String?
  suspendedUntil DateTime?  @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  @@index([status, joinedAt(sort: Desc)])
  @@index([reportCount])
  @@index([username])
  @@index([email])
}

// Event-fed read-model for the Livestream Management admin API.
// Populated by RabbitMQ consumer consuming stream.* events from aimess.events.
// communityName and creatorUsername are denormalized at ingest time from
// CommunityIndex / UserIndex (best-effort: empty string if not yet populated).
model LivestreamIndex {
  streamId         String    @id
  communityId      String
  communityName    String    @default("")
  creatorId        String
  creatorUsername  String    @default("")
  title            String
  description      String    @default("")
  thumbnailUrl     String?
  sourceType       String    @default("")
  status           String    @default("PENDING")
  hlsUrl           String?
  flvUrl           String?
  viewerCount      Int       @default(0)
  peakViewers      Int       @default(0)
  totalComments    Int       @default(0)
  livedAt          DateTime? @db.Timestamptz(3)
  endedAt          DateTime? @db.Timestamptz(3)
  durationSeconds  Int       @default(0)
  reasonCode       String?
  endedByAdminId   String?
  endedByAdminName String?
  createdAt        DateTime  @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt(sort: Desc)])
  @@index([communityId, status])
  @@index([creatorId])
}

// -----------------------------------------------------------------------------
// Future: report queue (counter static until built)
// -----------------------------------------------------------------------------
model Report {
  id         String   @id @default(uuid()) @db.Uuid
  type       String // user | community | message | stream
  targetId   String
  reporterId String
  reason     String
  details    String? // reporter free-text ("Other Reason")
  // Community the report was filed in (community-service member/community
  // reports only). Null for community-less reports (e.g. chat-service
  // private-message reports). Carried on the admin.report.ingest event.
  // The community's name is intentionally NOT denormalized here — it's
  // resolved live from community-service via this id on every read, so it's
  // never stale (see report.repository.ts buildListEnrichment).
  communityId String?
  // The reported USER when the target itself isn't a user (message sender for
  // message reports; comment author for stream reports). Null for user/community
  // reports (target already IS the user, or there is none). Carried on the
  // admin.report.ingest event so getCore can hydrate reportedUser for non-USER
  // report types without a cross-service lookup on every read.
  reportedUserId String? @db.Uuid
  // Conversation the report was filed from — private room id / group room id /
  // community id, plus which of the three. Carried on the
  // admin.report.ingest event. Null on every pre-existing row (nothing carried
  // it before), so reads must treat it as optional.
  roomId     String?
  roomType   String? // PRIVATE | GROUP | COMMUNITY
  status     String   @default("open") // open | reviewing | resolved | dismissed
  priority   String   @default("normal")
  assignedTo String?  @db.Uuid
  // Upstream report row's id (community/chat-service). Carried on the
  // admin.report.ingest event; the unique index makes ingestion exactly-once
  // — a RabbitMQ redelivery hits a P2002 the consumer swallows instead of
  // inserting a duplicate. Nullable for pre-existing / non-event rows; Postgres
  // unique indexes treat NULLs as distinct, so "unique where not null" holds.
  sourceReportId String? @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  // Decision fields — populated once an admin resolves/dismisses the report.
  // `assignedTo` doubles as the deciding moderator's id once actioned (no
  // separate "assignee" concept exists yet, so we don't add a second column).
  resolution    String? // ACTION_TAKEN | WARNING_ISSUED | CONTENT_REMOVED
  dismissReason String? // NO_VIOLATION | INSUFFICIENT_EVIDENCE | DUPLICATE | FALSE_REPORT
  decisionNote  String?
  resolvedAt    DateTime? @db.Timestamptz(3)

  notes ReportNote[]

  @@index([status, type])
  @@index([type, targetId, createdAt(sort: Desc)])
  @@index([reporterId])
  @@index([communityId])
  @@index([reportedUserId])
  @@index([roomType, roomId])
}

model ReportNote {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @db.Uuid
  report    Report   @relation(fields: [reportId], references: [id])
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
