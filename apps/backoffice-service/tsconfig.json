{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Required even though tsconfig.base.json sets it: relative paths in an
    // extended config resolve against the BASE file's directory, so the
    // inherited value points at <repo-root>/dist. Every other service
    // re-declares it for the same reason.
    "outDir": "dist"
  },
  "include": ["src"],
  // Tests are never part of the shipped build. Jest runs only `tests/**` (see
  // tooling/jest/jest.preset.cjs) and transpiles with `diagnostics: false`, so
  // compiling test files here only lets a mock's type mismatch break `docker
  // build`. Every other service keeps tests outside `src`; this service has
  // legacy `__tests__` folders inside it, so exclude them explicitly.
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
