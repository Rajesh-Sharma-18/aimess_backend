NODE_ENV=
USER_SERVICE_PORT=

# =========================
# POSTGRES (Prisma migrate reads prisma.config.ts — set at least one URL)
# =========================
# Use DB aimess_users (created by docker/postgres/init). Password must be URL-encoded in the URL.
# Example: postgresql://aimess:YOUR_PASS@localhost:5433/aimess_users
USER_DATABASE_URL=

# =========================
# REDIS (response caching)
# =========================
REDIS_HOST=
REDIS_PORT=
REDIS_CACHE_ENABLED=true
# Validate username availability (seconds)
REDIS_CACHE_USERNAME_AVAIL_TTL_SEC=60
# Username taken negative cache (seconds)
REDIS_CACHE_USERNAME_TAKEN_TTL_SEC=86400
# GET /profiles/me DB record cache (seconds)
REDIS_CACHE_PROFILE_TTL_SEC=120
# Auth account summary cache when auth-service is unavailable (seconds)
REDIS_CACHE_ACCOUNT_TTL_SEC=300

# =========================
# RabbitMQ
# =========================
RABBITMQ_URL=

# =========================
# JWT (same JWT_ACCESS_SECRET as auth-service)
# =========================
JWT_ACCESS_SECRET=

# =========================
# Auth service (internal HTTP, for full profile aggregation)
# =========================
AUTH_SERVICE_URL=http://127.0.0.1:3001
AUTH_SERVICE_TIMEOUT_MS=3000

# =========================
# MinIO (S3-compatible avatar storage)
# =========================
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
# Quote if password contains # (otherwise .env treats rest as comment)
MINIO_SECRET_KEY=
# One bucket per media type (see src/lib/storage-buckets.ts)
MINIO_BUCKET_AVATARS=aimess-avatars
# MINIO_BUCKET_CHAT_MEDIA=aimess-chat
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRES_IN=900
# Presigned GET for avatar display (bucket private)
MINIO_AVATAR_VIEW_EXPIRES_IN=3600
# 5 MB default
AVATAR_MAX_UPLOAD_BYTES=5242880