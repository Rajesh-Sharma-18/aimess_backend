NODE_ENV=
USER_SERVICE_PORT=
USER_GRPC_PORT=4002

# =========================
# POSTGRES (Prisma migrate reads prisma.config.ts â€” set at least one URL)
# =========================
# Use DB aimess_users (created by docker/postgres/init). Password must be URL-encoded in the URL.
# Example: postgresql://aimess:YOUR_PASS@localhost:5433/aimess_users
USER_DATABASE_URL=

# =========================
# REDIS (response caching)
# =========================
REDIS_HOST=
REDIS_PORT=
# Leave EMPTY for a local unauthenticated Redis. REQUIRED for any shared or
# remote Redis (which must never be left open) — without it every command
# fails with NOAUTH.
REDIS_PASSWORD=
REDIS_CACHE_ENABLED=true
# Validate username availability (seconds)
REDIS_CACHE_USERNAME_AVAIL_TTL_SEC=60
# Username taken negative cache (seconds)
REDIS_CACHE_USERNAME_TAKEN_TTL_SEC=86400
# GET /profiles/me DB record cache (seconds)
REDIS_CACHE_PROFILE_TTL_SEC=120
# Auth account summary cache when auth-service is unavailable (seconds)
REDIS_CACHE_ACCOUNT_TTL_SEC=300

# =========================
# RabbitMQ
# =========================
RABBITMQ_URL=

# =========================
# JWT (same JWT_ACCESS_SECRET as auth-service)
# =========================
JWT_ACCESS_SECRET=

# =========================
# Auth service (gRPC, for full profile aggregation)
# =========================
AUTH_GRPC_URL=0.0.0.0:4001

# =========================
# Chat service (gRPC, for User Search room/group resolution)
# =========================
CHAT_GRPC_URL=0.0.0.0:4004

# media-service gRPC — avatar scan-verdict verification before persist.
MEDIA_GRPC_URL=0.0.0.0:4009
AVATAR_MEDIA_VERIFY_ENABLED=true

# =========================
# MinIO (S3-compatible avatar storage)
# =========================
MINIO_ENDPOINT=http://127.0.0.1:9000
# Client-facing MinIO host used to sign upload/view URLs (LAN IP in dev, CDN/public domain in prod).
# Leave blank to reuse MINIO_ENDPOINT (only works when the client is on the same machine).
MINIO_PUBLIC_ENDPOINT=
# MinIO credentials — this service's OWN scoped account, not the root user.
#
# Six services used to hold the MinIO root credentials, which can read and
# delete every object in every bucket and drop the buckets themselves, so a leak
# from any one of them handed over all user media at once. This account is
# limited by `deploy/minio/init-buckets.sh` to the buckets listed below.
#
# The secret must match MINIO_SECRET_USER in the root .env, which is what
# provisions the account.
MINIO_ACCESS_KEY=aimess-user
# Quote if password contains # (otherwise .env treats rest as comment)
MINIO_SECRET_KEY=
# One bucket per media type (see src/lib/storage-buckets.ts)
MINIO_BUCKET_AVATARS=aimess-avatars
# MINIO_BUCKET_CHAT_MEDIA=aimess-chat
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRES_IN=900
# Presigned GET for avatar display (bucket private)
MINIO_AVATAR_VIEW_EXPIRES_IN=3600
# 5 MB default
AVATAR_MAX_UPLOAD_BYTES=5242880

# =========================
# Auth service HTTP timeout
# =========================
# Timeout (ms) for outbound HTTP calls to auth-service (account aggregation).
AUTH_SERVICE_TIMEOUT_MS=3000
# =========================
# Internal gRPC service auth
# =========================
# Shared bearer token every service attaches to outgoing gRPC calls and
# validates on incoming ones. MUST be identical across ALL services.
# Unset + NODE_ENV=production => services refuse to start (fail fast rather
# than silently accepting anonymous internal calls). Unset in dev => auth is
# disabled with a startup warning. A value published in this repository (the
# old "dev-grpc-service-token-change-me") is now rejected in production too.
# Generate one per environment: openssl rand -base64 32
GRPC_SERVICE_TOKEN=
