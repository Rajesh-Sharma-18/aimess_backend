NODE_ENV=development
STREAM_SERVICE_PORT=3007
STREAM_GRPC_PORT=4007

# =========================
# MongoDB (Prisma db push reads prisma.config.ts)
# =========================
# Single-node replica set rs0, no auth (see docker-compose mongodb). directConnection=true
# so the host driver talks directly to the single node instead of doing RS discovery.
# Port 27018 matches MONGODB_PORT in root .env (docker-compose maps 27018→27017 inside container).
STREAM_DATABASE_URL=mongodb://localhost:27018/stream_db?directConnection=true

# =========================
# REDIS
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CACHE_ENABLED=true

# =========================
# RabbitMQ (reserved for future stream events; optional on boot)
# =========================
RABBITMQ_URL=amqp://aimess_rabbit:kKPF9jkbU6i2GGd@127.0.0.1:5673

# =========================
# JWT (same JWT_ACCESS_SECRET as auth-service / user-service)
# =========================
JWT_ACCESS_SECRET=

# user-service gRPC endpoint — comment author snapshots
USER_GRPC_URL=0.0.0.0:4002
# community-service gRPC endpoint — go-live membership validation
COMMUNITY_GRPC_URL=0.0.0.0:4003

# =========================
# Livestream policy
# =========================
# Comma-separated ingest modes minted to a creator on go-live (whip|rtmp)
STREAM_INGEST_MODES=whip,rtmp
# Max simultaneous PENDING+LIVE streams a single community may have
STREAM_MAX_CONCURRENT_PER_COMMUNITY=5
# When true, go-live requires the creator be an ACTIVE community member
STREAM_REQUIRE_MEMBERSHIP=true

# =========================
# SRS (OSSRS) media server
# =========================
# HTTP API base — list/kick publishers, query streams
SRS_API_URL=http://localhost:1985
# RTMP host — ffmpeg push target for URL re-stream mode
SRS_RTMP_HOST=localhost
# Base for HLS/FLV playback URLs minted for viewers
SRS_HLS_BASE=http://localhost:8080
# Base for WHIP (WebRTC) publish URLs minted for phone-camera ingest
SRS_WHIP_BASE=http://localhost:1985
# Shared secret the /internal/srs/hooks endpoint validates
SRS_HOOK_SECRET=
# ffmpeg binary path for URL re-stream ingest (host prerequisite in dev)
FFMPEG_PATH=ffmpeg
