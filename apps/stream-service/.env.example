NODE_ENV=development
STREAM_SERVICE_PORT=3007
STREAM_GRPC_PORT=4007

# =========================
# MongoDB (Prisma db push reads prisma.config.ts)
# =========================
# Single-node replica set rs0, no auth (see docker-compose mongodb). directConnection=true
# so the host driver talks directly to the single node instead of doing RS discovery.
# Port 27018 matches MONGODB_PORT in root .env (docker-compose maps 27018â†’27017 inside container).
STREAM_DATABASE_URL=mongodb://localhost:27018/stream_db?directConnection=true

# =========================
# REDIS
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave EMPTY for a local unauthenticated Redis. REQUIRED for any shared or
# remote Redis (which must never be left open) — without it every command
# fails with NOAUTH.
REDIS_PASSWORD=
REDIS_CACHE_ENABLED=true

# =========================
# RabbitMQ (reserved for future stream events; optional on boot)
# =========================
RABBITMQ_URL=amqp://aimess_rabbit:kKPF9jkbU6i2GGd@127.0.0.1:5673

# =========================
# JWT (same JWT_ACCESS_SECRET as auth-service / user-service)
# =========================
JWT_ACCESS_SECRET=

# user-service gRPC endpoint â€” comment author snapshots
USER_GRPC_URL=0.0.0.0:4002
# community-service gRPC endpoint â€” go-live membership validation
COMMUNITY_GRPC_URL=0.0.0.0:4003

# =========================
# Livestream policy
# =========================
# Comma-separated ingest modes minted to a creator on go-live (whip|rtmp)
STREAM_INGEST_MODES=whip,rtmp
# Max simultaneous PENDING+LIVE streams a single community may have
STREAM_MAX_CONCURRENT_PER_COMMUNITY=5
# When true, go-live requires the creator be an ACTIVE community member
STREAM_REQUIRE_MEMBERSHIP=true
# Per-creator sliding-window rate limit on POST /streams.
STREAM_CREATE_RATE_WINDOW_SEC=60
STREAM_CREATE_RATE_MAX=5

# =========================
# SRS (OSSRS) media server
# =========================
# HTTP API base â€” list/kick publishers, query streams
SRS_API_URL=http://localhost:1985
# RTMP host â€” ffmpeg push target for URL re-stream mode
SRS_RTMP_HOST=localhost
# Base for HLS/FLV playback URLs minted for viewers
SRS_HLS_BASE=http://localhost:8080
# Base for WHIP (WebRTC) publish URLs minted for phone-camera ingest
SRS_WHIP_BASE=http://localhost:1985
# Shared secret the /internal/srs/hooks endpoint validates (required â€” service
# fails to boot if unset; must also be embedded in docker/srs/aimess.conf's
# http_hooks URLs as ?secret=...)
SRS_HOOK_SECRET=
# ffmpeg binary path for URL re-stream ingest (host prerequisite in dev)
FFMPEG_PATH=ffmpeg

# =========================
# MinIO (resolve stored senderAvatar object keys to full download URLs)
# =========================
MINIO_ENDPOINT=http://localhost:9000
# Public endpoint for presigned URLs handed to remote clients.
# Leave blank to reuse MINIO_ENDPOINT (only works when the client is on the same machine).
MINIO_PUBLIC_ENDPOINT=
# MinIO credentials — this service's OWN scoped account, not the root user.
#
# Six services used to hold the MinIO root credentials, which can read and
# delete every object in every bucket and drop the buckets themselves, so a leak
# from any one of them handed over all user media at once. This account is
# limited by `deploy/minio/init-buckets.sh` to the buckets listed below.
#
# The secret must match MINIO_SECRET_STREAM in the root .env, which is what
# provisions the account.
MINIO_ACCESS_KEY=aimess-stream
MINIO_SECRET_KEY=
MINIO_BUCKET_AVATARS=aimess-avatars
MINIO_REGION=us-east-1
MINIO_VIEW_EXPIRES_IN=3600

# =========================
# Internal gRPC service auth
# =========================
# Shared bearer token every service attaches to outgoing gRPC calls and
# validates on incoming ones. MUST be identical across ALL services.
# Unset + NODE_ENV=production => services refuse to start (fail fast rather
# than silently accepting anonymous internal calls). Unset in dev => auth is
# disabled with a startup warning. A value published in this repository (the
# old "dev-grpc-service-token-change-me") is now rejected in production too.
# Generate one per environment: openssl rand -base64 32
GRPC_SERVICE_TOKEN=
