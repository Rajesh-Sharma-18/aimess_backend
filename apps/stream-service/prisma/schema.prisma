// =============================================================================
// stream-service  ·  MongoDB  ·  stream_db
// Owns: livestream lifecycle (phone-camera WHIP + URL re-stream) and comments.
//
// creatorId / sentBy / userId here = auth-service AuthUser.id (UUID string,
// no FK across DBs / services).
//
// NOTE: the local Mongo runs as a single-node replica set rs0
// (directConnection=true). Prisma's Mongo connector requires a replica set for
// @unique-indexed writes (e.g. streamKey).
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("STREAM_DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Livestream — one go-live session for a community, either ingest mode.
//   sourceType: PHONE_CAMERA (WebRTC/WHIP) | URL (backend ffmpeg re-stream)
//   status:     PENDING | LIVE | RECONNECTING | ENDED
//
//   RECONNECTING is a transient sub-state of a LIVE session: SRS reported
//   on_unpublish (publisher dropped — refresh, mobile blip, network hiccup),
//   but the stream is given a grace window (STREAM_RECONNECT_GRACE_MS) to
//   republish on the same streamKey before being finalized ENDED. See
//   LivestreamService.handleUnpublish/handlePublish and the stale-stream
//   sweeper's sweepStaleReconnectingStreams.
// -----------------------------------------------------------------------------
model Livestream {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  communityId   String
  creatorId     String
  title         String
  description   String    @default("")
  thumbnail     String?
  sourceType    String // PHONE_CAMERA | URL
  sourceUrl     String? // set for URL mode only
  streamKey     String    @unique
  status        String    @default("PENDING")
  hlsUrl        String?
  flvUrl        String?
  dashUrl       String?
  commentStatus Boolean   @default(true)
  viewerCount   Int       @default(0)
  peakViewers   Int       @default(0)
  totalViews    Int       @default(0)
  totalComments Int       @default(0)
  livedAt          DateTime?
  endedAt          DateTime?
  // Stamped when a LIVE stream enters RECONNECTING (on_unpublish); cleared on
  // resume. Drives the grace-window cutoff — distinct from lastHeartbeatAt,
  // which tracks the separate "owner's client is alive" signal.
  disconnectedAt   DateTime?
  // SRS `client_id` of the publisher connection currently on air, recorded from
  // the on_publish hook. A WHIP reconnect is DELETE(old)+POST(new) and SRS
  // dispatches both hooks asynchronously, so the old session's on_unpublish can
  // arrive AFTER the new session's on_publish. Comparing ids lets
  // handleUnpublish drop a hook belonging to a superseded connection instead of
  // demoting a healthily-publishing stream. Null when unknown (manual markLive,
  // pre-existing rows) — in that case the hook is honoured as before.
  publisherClientId String?
  lastHeartbeatAt  DateTime?
  // Set when the browser publisher reports its camera track ended
  // (device unplug / MediaTrack ended). Cleared on restore. Viewers read
  // this on stream:join to show the "camera disconnected" overlay if they
  // join mid-grace. Client owns the 60s grace-timer that auto-ends the
  // stream; this field is purely for state relay + late-joiner snapshot.
  videoLostAt      DateTime?
  // Last self-reported (browser WHIP) or server-polled (OBS/SRS) quality
  // snapshot. Null until the first report arrives after go-live.
  lastKnownResolution   String?
  lastKnownBitrateKbps  Int?
  lastKnownFps          Int?
  qualityUpdatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([communityId])
  @@index([status])
  @@index([status, lastHeartbeatAt])
  @@index([status, disconnectedAt])
  @@map("livestreams")
}

// -----------------------------------------------------------------------------
// LivestreamViewerSession — one join→leave watch session for a user on a
//   livestream. Durable history; Redis (`stream:session:users:<streamId>`,
//   owned by api-gateway) remains the source of truth for CURRENT live
//   presence/count — this table is only for "who watched, when, how long".
//   A user can have multiple sessions per stream (rejoin after a leave), but
//   at most ONE open session (leftAt: null) at a time — reconnects reuse the
//   open session instead of creating a duplicate.
// -----------------------------------------------------------------------------
model LivestreamViewerSession {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  livestreamId         String
  userId               String
  joinedAt             DateTime  @default(now())
  leftAt               DateTime?
  watchDurationSeconds Int?

  @@index([livestreamId, userId])
  @@index([livestreamId, joinedAt])
  @@map("livestream_viewer_sessions")
}

// -----------------------------------------------------------------------------
// LivestreamComment — realtime comments on a livestream.
//   Cursor pagination on (livestreamId, createdAt desc); clientCommentId gives
//   idempotency for at-least-once delivery from the gateway socket.
// -----------------------------------------------------------------------------
model LivestreamComment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  livestreamId    String
  sentBy          String
  senderName      String   @default("")
  senderAvatar    String   @default("")
  message         String
  clientCommentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([livestreamId, createdAt(sort: Desc)])
  @@index([livestreamId, sentBy, clientCommentId])
  @@map("stream_comments")
}

// -----------------------------------------------------------------------------
// LivestreamBan — a user barred from a livestream by its owner. Checked on
//   stream:join (gateway → gRPC CheckStreamAccess) and used to kick the user's
//   live sockets in real time.
// -----------------------------------------------------------------------------
model LivestreamBan {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  livestreamId        String
  bannedUserId        String
  bannedBy            String // owner who issued the ban (auth-service AuthUser.id)
  reason              String?
  bannedAt            DateTime @default(now())
  snapshotUsername    String?
  snapshotDisplayName String?

  @@index([livestreamId, bannedUserId])
  @@map("stream_bans")
}

// -----------------------------------------------------------------------------
// LivestreamCommentReport — user-submitted report on a live chat comment.
//   reason: OFFENSIVE_LANGUAGE | SPAM | INAPPROPRIATE_CONTENT | SCAM_OR_FRAUD | IMPERSONATION | OTHER
//   details: optional free-text up to 500 chars
//   Unique on (commentId, reportedBy) — one report per user per comment.
// -----------------------------------------------------------------------------
model LivestreamCommentReport {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  commentId    String
  livestreamId String
  reportedBy   String // userId who submitted the report
  reason       String // enum: OFFENSIVE_LANGUAGE | SPAM | INAPPROPRIATE_CONTENT | SCAM_OR_FRAUD | IMPERSONATION | OTHER
  details      String? // optional free-text context
  createdAt    DateTime @default(now())

  @@unique([commentId, reportedBy])
  @@index([livestreamId])
  @@index([commentId])
  @@map("stream_comment_reports")
}
