NODE_ENV=
AUTH_SERVICE_PORT=

# =========================
# POSTGRES (Prisma migrate reads prisma.config.ts — set at least one URL)
# =========================
AUTH_DATABASE_URL=

# =========================
# REDIS
# =========================
REDIS_HOST=
REDIS_PORT=

# =========================
# JWT
# =========================

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Expiry in seconds (e.g. 3600 = 1 hour access, 604800 = 7 days refresh)
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# =========================
# Password reset / OTP (dev: fixed code, no email yet)
# =========================
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
OTP_DEV_FIXED_CODE=123456

# =========================
# Social login (Firebase) — verifies the Firebase ID token the mobile client
# obtains after Google / Apple sign-in. Firebase Console → Project Settings →
# Service accounts → "Generate new private key" gives a JSON with these fields.
# =========================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the full key as a single line with literal \n for newlines, in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# =========================
# RabbitMQ
# =========================
RABBITMQ_URL=