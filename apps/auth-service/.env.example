NODE_ENV=
AUTH_SERVICE_PORT=

# =========================
# POSTGRES (Prisma migrate reads prisma.config.ts — set at least one URL)
# =========================
AUTH_DATABASE_URL=

# =========================
# REDIS
# =========================
REDIS_HOST=
REDIS_PORT=

# =========================
# JWT
# =========================

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Expiry in seconds (e.g. 3600 = 1 hour access, 604800 = 7 days refresh)
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800
# Refresh lifetime when the client logs in with rememberMe:true (default 30 days)
JWT_REFRESH_EXPIRES_IN_REMEMBER_ME=2592000

# =========================
# Password reset / OTP (dev: fixed code, no email yet)
# =========================
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
OTP_DEV_FIXED_CODE=123456

# =========================
# Google OAuth — Google Cloud Console → APIs & Services → Credentials.
# One OAuth 2.0 Client ID per mobile platform. Both are accepted as valid `aud`
# values when verifying Google ID tokens, so the same backend serves both apps.
# Set at least one to enable Google login/link.
# =========================
GOOGLE_OAUTH_APPLE_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# =========================
# Sign in with Apple — comma-separated list of accepted `aud` values: your iOS
# Bundle ID (native Sign in with Apple) and/or Apple Service ID (web). Apple ID
# tokens are verified directly against Apple's JWKS (no Firebase).
# =========================
APPLE_CLIENT_IDS=com.example.yourapp

# =========================
# RabbitMQ
# =========================
RABBITMQ_URL=

# =========================
# Notifications service URL (used by dev-only POST /api/auth/test/push)
# =========================
NOTIFICATIONS_SERVICE_URL=http://localhost:3006