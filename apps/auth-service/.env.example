NODE_ENV=
AUTH_SERVICE_PORT=
# gRPC port for admin-dashboard read-only aggregation
AUTH_GRPC_PORT=4001

# =========================
# POSTGRES (Prisma migrate reads prisma.config.ts â€” set at least one URL)
# =========================
AUTH_DATABASE_URL=

# =========================
# REDIS
# =========================
REDIS_HOST=
REDIS_PORT=
# Leave EMPTY for a local unauthenticated Redis. REQUIRED for any shared or
# remote Redis (which must never be left open) — without it every command
# fails with NOAUTH.
REDIS_PASSWORD=

# =========================
# JWT
# =========================

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cost of creating an account or probing whether a handle is taken, in leading
# zero bits the caller's proof-of-work hash must have. Both endpoints used to be
# free to call. 20 is a fraction of a second on a phone and a million times that
# for someone enumerating a million handles; raise it during a signup flood, the
# cost is paid entirely by the caller. Optional, defaults to 20.
SIGNUP_CHALLENGE_DIFFICULTY_BITS=20

# Expiry in seconds (e.g. 3600 = 1 hour access, 604800 = 7 days refresh)
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800
# Refresh lifetime when the client logs in with rememberMe:true (default 30 days)
JWT_REFRESH_EXPIRES_IN_REMEMBER_ME=2592000

# =========================
# Refresh-token cookie (AIM-02)
# =========================
# The refresh token is also returned as an httpOnly cookie so the browser never
# has to keep a credential in JS. The JSON body still carries it for native
# clients. Unset AUTH_COOKIE_SECURE means "true in production, false in dev".
# AUTH_COOKIE_SECURE=true
# lax works when the site and the API share a registrable domain
# (ai5dev.tech / api.ai5dev.tech). Genuinely cross-site dev tunnels need
# none, which browsers reject unless AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SAMESITE=lax
# Public path the browser sees; the gateway rewrites it to /api/auth downstream.
AUTH_COOKIE_PATH=/api/v1/auth
# POST /auth/refresh and /auth/token send no Authorization header once the
# cookie is the credential, so they get their own per-IP limiter.
REFRESH_RATE_LIMIT_MAX=60
REFRESH_RATE_LIMIT_WINDOW_MINUTES=5

# =========================
# Password reset / OTP (dev: fixed code, no email yet)
# =========================
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
OTP_DEV_FIXED_CODE=123456

# =========================
# Google OAuth â€” Google Cloud Console â†’ APIs & Services â†’ Credentials.
# One OAuth 2.0 Client ID per mobile platform. Both are accepted as valid `aud`
# values when verifying Google ID tokens, so the same backend serves both apps.
# Set at least one to enable Google login/link.
# =========================
GOOGLE_OAUTH_APPLE_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# =========================
# Sign in with Apple â€” comma-separated list of accepted `aud` values: your iOS
# Bundle ID (native Sign in with Apple) and/or Apple Service ID (web). Apple ID
# tokens are verified directly against Apple's JWKS (no Firebase).
# =========================
APPLE_CLIENT_IDS=com.example.yourapp,yourservice.example.com

# =========================
# RabbitMQ
# =========================
RABBITMQ_URL=

# =========================
# Notifications service URL (used by dev-only POST /api/auth/test/push)
# =========================
NOTIFICATIONS_SERVICE_URL=http://localhost:3006

# backoffice-service gRPC — rejects emails already owned by an admin account
BACKOFFICE_GRPC_URL=localhost:4010

# =========================
# CORS
# =========================
CORS_ALLOWED_ORIGINS=*1

# =========================
# Rate limiting
# =========================
SENSITIVE_AUTH_RATE_LIMIT_MAX=20
SENSITIVE_AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# DELETE /auth/account attempts per hour per user (irreversible, password-gated)
DELETE_ACCOUNT_RATE_LIMIT_MAX=5
# POST /auth/change-password attempts per hour per user (verifies currentPassword)
CHANGE_PASSWORD_RATE_LIMIT_MAX=5
# Reverse-proxy hops (0 = local dev; 1 behind nginx/load balancer)
TRUST_PROXY_HOPS=0

# =========================
# OTP issuance throttle
# =========================
# Max OTP requests per sliding window (per-email + per-IP)
OTP_REQUEST_MAX=5
# Sliding window duration for OTP issuance throttle (seconds)
OTP_REQUEST_WINDOW_SEC=900

# =========================
# Login lockout
# =========================
# Max failed login attempts before temporary lockout
AUTH_MAX_FAILED_LOGINS=5
# Lockout window after threshold is hit (minutes)
AUTH_LOCKOUT_MINUTES=15

# =========================
# QR device-link (linked devices) login
# =========================
# QR login session lifetime, seconds (spec: 60)
QR_LINK_TTL_SECONDS=60
# Extra seconds the Redis key survives past expiresAt so the sweeper can still claim it
QR_LINK_SWEEP_GRACE_SECONDS=30
QR_LINK_SWEEPER_ENABLED=true
QR_LINK_SWEEPER_INTERVAL_MS=30000
# =========================
# Internal gRPC service auth
# =========================
# Shared bearer token every service attaches to outgoing gRPC calls and
# validates on incoming ones. MUST be identical across ALL services.
# Unset + NODE_ENV=production => services refuse to start (fail fast rather
# than silently accepting anonymous internal calls). Unset in dev => auth is
# disabled with a startup warning. A value published in this repository (the
# old "dev-grpc-service-token-change-me") is now rejected in production too.
# Generate one per environment: openssl rand -base64 32
GRPC_SERVICE_TOKEN=

BACKOFFICE_GRPC_URL=0.0.0.0:4010
