NODE_ENV=
AUTH_SERVICE_PORT=

# =========================
# POSTGRES (Prisma migrate reads prisma.config.ts — set at least one URL)
# =========================
AUTH_DATABASE_URL=

# =========================
# REDIS
# =========================
REDIS_HOST=
REDIS_PORT=

# =========================
# JWT
# =========================

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Expiry in seconds (e.g. 3600 = 1 hour access, 604800 = 7 days refresh)
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# =========================
# Password reset / OTP (dev: fixed code, no email yet)
# =========================
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
OTP_DEV_FIXED_CODE=123456

# =========================
# Social login (Google / Apple ID tokens from mobile or web SDK)
# =========================
# Comma-separated OAuth client IDs from Google Cloud Console
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com
# Apple bundle id and/or Services ID (comma-separated if multiple apps)
APPLE_CLIENT_IDS=com.aimess.app

# =========================
# RabbitMQ
# =========================
RABBITMQ_URL=