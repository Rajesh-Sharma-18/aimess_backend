// =============================================================================
// auth-service  ·  PostgreSQL  ·  auth_db
// Owns: user identity, login, OTP, password reset, social OAuth links,
//       sessions, refresh tokens, login attempts, account deletion grace.
// Does NOT own: profile data, avatars, bio, friendships, settings.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// AuthUser — the canonical identity record. Its id is the userId every other
// service references.
// -----------------------------------------------------------------------------
model AuthUser {
  id                   String               @id @default(uuid()) @db.Uuid
  // Login handles (one of these is required at registration)
  account              String               @unique // username/account for login
  email                String?              @unique
  phone                String?              @unique // future-proofing; SOW Phase 1 is email-first
  // Credentials
  passwordHash         String? // nullable: pure-social accounts have no password
  // Verification
  emailVerified        Boolean              @default(false)
  phoneVerified        Boolean              @default(false)
  ageVerified          Boolean              @default(false)
  // The first sign-in method linked to this account becomes its "primary"
  // account. Set once on the first successful link (email/Google/Apple) and
  // never overwritten thereafter. null until the first link happens.
  primaryAccount       AuthProvider?
  // Mirrored from user-service via the user.profile_updated event so the login
  // response can route the client to the edit-profile screen.
  isProfileCompleted   Boolean              @default(false)
  dateOfBirth          DateTime?            @db.Date // collected later (profile / compliance)
  // Legal acceptance — collected when user accepts terms (not required at minimal signup)
  termsAcceptedAt      DateTime?            @db.Timestamptz(3)
  privacyAcceptedAt    DateTime?            @db.Timestamptz(3)
  termsVersion         String?
  privacyVersion       String?
  // Account lifecycle
  role                 GlobalRole           @default(USER)
  status               AccountStatus        @default(ACTIVE)
  suspendedAt          DateTime?            @db.Timestamptz(3)
  suspendedReason      String?
  suspendedBy          String?              @db.Uuid // ops user id
  // Soft delete with 30-day grace period (SOW §4)
  deletionRequestedAt  DateTime?            @db.Timestamptz(3)
  scheduledDeletionAt  DateTime?            @db.Timestamptz(3)
  deletedAt            DateTime?            @db.Timestamptz(3)
  // Set when the grace period has elapsed and the personal data on this row has
  // actually been erased (see jobs/account-purge-sweeper.ts). Until this is
  // stamped, a "deleted" account still holds its email, phone, password hash
  // and provider identities in full — which is what made deletion a flag
  // rather than a deletion.
  purgedAt             DateTime?            @db.Timestamptz(3)
  // Security state
  failedLoginAttempts  Int                  @default(0)
  lockedUntil          DateTime?            @db.Timestamptz(3)
  lastLoginAt          DateTime?            @db.Timestamptz(3)
  lastPasswordChangeAt DateTime?            @db.Timestamptz(3)
  // Push notifications
  fcmTokens            String[]             @default([])
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  linkedAccounts       LinkedAccount[]
  refreshTokens        RefreshToken[]
  sessions             Session[]
  otpCodes             OtpCode[]
  passwordResetTokens  PasswordResetToken[]
  devices              UserDevice[]

  @@index([status, deletedAt])
  @@index([scheduledDeletionAt]) // for grace-period cleanup job
  @@map("auth_users")
}

// -----------------------------------------------------------------------------
// LinkedAccount — Apple / Google / Email linked to a single AuthUser
// SOW §1.1: "Link multiple sign-in methods... must maintain at least 1 method"
// -----------------------------------------------------------------------------
model LinkedAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  user           AuthUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String // Google `sub`, Apple `sub`, or "email"
  email          String? // email reported by the provider (may differ from primary)
  displayName    String?
  linkedAt       DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([provider, providerUserId])
  @@unique([userId, provider]) // one provider link per user max
  @@index([userId])
  @@map("linked_accounts")
}

// -----------------------------------------------------------------------------
// OtpCode — registration, password reset, email change, etc.
// -----------------------------------------------------------------------------
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  // Anchor — either a known userId (for change flows) OR an identifier (for registration / forgot password)
  userId      String?    @db.Uuid
  user        AuthUser?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier  String // email or phone the OTP was sent to
  channel     OtpChannel
  purpose     OtpPurpose
  codeHash    String // bcrypt hash of the OTP, NEVER plaintext
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime   @db.Timestamptz(3)
  consumedAt  DateTime?  @db.Timestamptz(3)
  ipAddress   String? // for abuse tracking
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  @@index([identifier, purpose, consumedAt])
  @@index([userId, purpose])
  @@index([expiresAt]) // cleanup job
  @@map("otp_codes")
}

// -----------------------------------------------------------------------------
// PasswordResetToken — one-time-use token issued after OTP verification 
// -----------------------------------------------------------------------------
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// Session — one row per device. SOW §1.1 "View connected devices and remote sign-out"
// -----------------------------------------------------------------------------
model Session {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @db.Uuid
  user          AuthUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String // client-generated stable device identifier
  deviceName    String? // "Pixel 8 — Hanoi"
  deviceType    DeviceType
  osVersion     String?
  appVersion    String?
  ipAddress     String?
  userAgent     String?
  countryCode   String? // GeoIP
  lastActiveAt  DateTime             @default(now()) @db.Timestamptz(3)
  revokedAt     DateTime?            @db.Timestamptz(3)
  revokedReason SessionRevokeReason?
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)

  refreshTokens RefreshToken[]

  // No @@unique([userId, deviceId]): deviceId is a server-computed
  // userAgent+ip fingerprint (see session-context.ts), not a real
  // per-installation id, so distinct logins (browser profiles, incognito,
  // shared-IP devices) can share it. A unique constraint here previously made
  // createSessionWithRefreshToken delete the other login's still-active
  // session on every new login that happened to collide.
  @@index([userId, deviceId])
  @@index([userId, revokedAt])
  @@index([lastActiveAt])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// UserDevice — one row per (user, client-supplied deviceId).
//
// Distinct from `Session` on purpose. A Session is one LOGIN: it is created per
// sign-in, revoked on logout, and a device that signs in twice without signing
// out legitimately owns two of them. A UserDevice is the physical/browser
// INSTALL behind those logins, so it is upserted — never duplicated — on every
// authentication that carries a `device` payload, and it is what the "Linked
// devices" and Super Admin device screens list.
//
// Scoped by `userId` as well as `deviceId`: a shared browser or a resold phone
// reports the same deviceId for two different accounts, and one account must
// never be able to read the other's device metadata. Enforced by the composite
// unique below, not by service code alone.
//
// Every metadata column is nullable: the payload itself is optional (older
// clients send none) and web cannot legitimately supply the Android-only
// fields. `isEmulator` / `isRooted` / `installerPackage` are CLIENT CLAIMS —
// all three are trivially spoofable, so they are stored as fraud signals to
// look at, never as an authorization input.
// -----------------------------------------------------------------------------
model UserDevice {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  user     AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Client-generated stable per-install id. The SAME value the client sends to
  // `POST /api/v1/devices` for push, so a device has one identity across
  // sessions, push tokens and this table.
  deviceId String

  // Identity
  platform   DeviceType // ANDROID | IOS | WEB (DESKTOP never arrives from a client)
  deviceType DeviceFormFactor? // PHONE | TABLET | DESKTOP — form factor, NOT the platform
  deviceName String?

  // Hardware / OS
  manufacturer String?
  brand        String?
  model        String?
  osVersion    String?
  sdkInt       Int? // Android Build.VERSION.SDK_INT; null everywhere else

  // Application
  appVersion       String?
  appBuild         Int?
  buildType        String? // "debug" | "release"
  installerPackage String? // null when sideloaded, and always on web

  // Locale
  locale           String?
  language         String?
  country          String? // derived from the LOCALE, never from SIM/GPS/IP
  timezone         String?
  utcOffsetMinutes Int?

  // Display
  screenWidthPx    Int?
  screenHeightPx   Int?
  screenDensityDpi Int? // Android-style DPI; web sends round(devicePixelRatio * 160)

  // Network
  networkType NetworkType?
  carrier     String?

  // Fraud signals — client-asserted, spoofable, never used to block on their own.
  isEmulator Boolean?
  isRooted   Boolean?

  // Server-derived, never accepted from the client (see the mobile contract).
  ipAddress   String?
  countryCode String? // GeoIP / edge header
  userAgent   String?

  lastSeenAt  DateTime @default(now()) @db.Timestamptz(3)
  lastLoginAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, deviceId])
  @@index([userId, lastSeenAt])
  @@map("user_devices")
}

// -----------------------------------------------------------------------------
// RefreshToken — rotated on every use. Short access token (15m), long refresh (7d).
// `rotatedToId` lets you detect refresh-token reuse attacks.
// -----------------------------------------------------------------------------
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String    @db.Uuid
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique // SHA-256 of the refresh token
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  rotatedToId String?   @db.Uuid // points to the successor token after refresh
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// LoginAttempt — security audit, drives lockout logic
// -----------------------------------------------------------------------------
model LoginAttempt {
  id            String              @id @default(uuid()) @db.Uuid
  identifier    String // account or email used to attempt login
  userId        String?             @db.Uuid // populated if identifier matched a user
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason LoginFailureReason?
  attemptedAt   DateTime            @default(now()) @db.Timestamptz(3)

  @@index([identifier, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@index([userId, attemptedAt])
  @@map("login_attempts")
}

// -----------------------------------------------------------------------------
// AuthAuditLog — append-only security/audit trail for auth-service events that
// don't fit LoginAttempt's login-only shape (QR device-link lifecycle, etc).
// No FK to AuthUser: `userId` may be null (e.g. QR_CREATED happens before any
// user is involved) and must never block the write on referential integrity —
// mirrors LoginAttempt's plain optional `userId` above rather than a `@relation`.
// This is auth-service's own audit trail; backoffice's `AuditLog` model is
// admin-only (`actorId` FK → AdminUser) and cannot record end-user events.
// -----------------------------------------------------------------------------
model AuthAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  event      String // "QR_CREATED" | "QR_SCANNED" | "QR_APPROVED" | ...
  targetType String // "qr_login_session" | "linked_device"
  targetId   String? // linkToken or sessionId
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([event, createdAt])
  @@index([targetType, targetId])
  @@index([userId, createdAt])
  @@map("auth_audit_logs")
}

// =============================================================================
// Enums
// =============================================================================

enum AccountStatus {
  ACTIVE
  SUSPENDED // by ops team — temporary
  BANNED // permanent
  PENDING_DELETION // 30-day grace
  DELETED // tombstone
}

enum AuthProvider {
  EMAIL
  APPLE
  GOOGLE
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  REGISTRATION
  LOGIN_2FA
  PASSWORD_RESET
  EMAIL_VERIFY
  EMAIL_CHANGE
  PHONE_CHANGE
  ACCOUNT_DELETION_CONFIRM
}

enum DeviceType {
  IOS
  ANDROID
  WEB
  DESKTOP
}

// Form factor reported by the client. Orthogonal to `DeviceType`, which is the
// PLATFORM: an Android phone is (platform ANDROID, deviceType PHONE) and a
// desktop browser is (platform WEB, deviceType DESKTOP).
//
// DESKTOP exists here for the web client only. Android/iOS send PHONE or
// TABLET exclusively, so adding it does not change anything they can send.
enum DeviceFormFactor {
  PHONE
  TABLET
  DESKTOP
}

enum NetworkType {
  WIFI
  CELLULAR
  ETHERNET
  VPN
  OTHER
  NONE
  UNKNOWN
}

enum SessionRevokeReason {
  USER_SIGNED_OUT
  PASSWORD_CHANGED
  REMOTE_SIGNOUT
  ADMIN_REVOKED
  SUSPICIOUS_ACTIVITY
  TOKEN_REUSE_DETECTED
  ACCOUNT_DELETED
}

enum LoginFailureReason {
  INVALID_CREDENTIALS
  ACCOUNT_NOT_FOUND
  ACCOUNT_LOCKED
  ACCOUNT_SUSPENDED
  ACCOUNT_DELETED
  EMAIL_NOT_VERIFIED
  OAUTH_FAILURE
}

enum GlobalRole {
  USER
  ADMIN
}
