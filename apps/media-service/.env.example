NODE_ENV=development
MEDIA_SERVICE_PORT=3009
MEDIA_GRPC_PORT=4009

JWT_ACCESS_SECRET=your-jwt-access-secret-here
# Optional: same value as backoffice-service's JWT_ADMIN_SECRET. When set,
# upload-url/confirm/etc. also accept a backoffice admin access token, so
# Backoffice avatar upload reuses this endpoint instead of a separate one.
JWT_ADMIN_SECRET=

# chat-service gRPC â€” authorizes chat-scoped attachment downloads against
# room/group/community membership (CheckMediaAccess RPC).
CHAT_GRPC_URL=127.0.0.1:4004

CORS_ALLOWED_ORIGINS=*

# MinIO / S3 compatible storage
MINIO_ENDPOINT=http://10.0.127.227:9000

# Client-facing MinIO host used to sign upload/view URLs (tunnel URL so teammates can access media).
MINIO_PUBLIC_ENDPOINT=http://10.0.127.227:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET_AVATARS=aimess-avatars
MINIO_BUCKET_COMMUNITY=aimess-community
MINIO_BUCKET=aimess-chat

# Livestream thumbnails (backoffice uploads here; media-service provisions it
# and now runs the shared security pipeline over the uploaded bytes).
MINIO_BUCKET_STREAM=aimess-stream
STREAM_THUMBNAIL_MAX_BYTES=5242880
MINIO_PRESIGN_EXPIRES_IN=900
# Max is 604800 (7 days) â€” S3/MinIO hard limit. Set to 7 days so FE never
# needs to refresh a download URL within a normal session.
MINIO_VIEW_EXPIRES_IN=604800

AVATAR_MAX_UPLOAD_BYTES=5242880
COMMUNITY_IMAGE_MAX_UPLOAD_BYTES=5242880
CHAT_VIDEO_MAX_BYTES=104857600
COMMUNITY_CHAT_MAX_BYTES=104857600
GROUP_CHAT_MAX_BYTES=104857600
# Per-MIME chat-attachment caps â€” must match chat-service's .env.example values.
CHAT_IMAGE_MAX_BYTES=26214400
CHAT_AUDIO_MAX_BYTES=26214400
CHAT_DOCUMENT_MAX_BYTES=26214400

# â”€â”€â”€ Redis (scan-status cache) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave EMPTY for a local unauthenticated Redis. REQUIRED for any shared or
# remote Redis (which must never be left open) — without it every command
# fails with NOAUTH.
REDIS_PASSWORD=

# â”€â”€â”€ ClamAV antivirus scanner â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Set CLAMAV_ENABLED=true in staging/production. Leave false for local dev
# unless you have the clamav Docker service running (first boot downloads ~350 MB
# of virus definitions â€” see docker-compose.yml clamav service).
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_MS=30000

# â”€â”€â”€ ZIP security â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Maximum allowed uncompressed:compressed ratio. A ZIP with 100 bytes on disk
# that unpacks to more than ZIP_MAX_COMPRESSION_RATIO Ã— 100 bytes is rejected
# as a potential ZIP bomb. 100 is a conservative production default.
ZIP_MAX_COMPRESSION_RATIO=100

# â”€â”€â”€ Scan-status TTL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# How long a CLEAN/QUARANTINED scan status is cached in Redis (seconds).
# Default: 7 days. A re-confirm is required after this window expires.
SCAN_STATUS_TTL_SECONDS=604800

# â”€â”€â”€ Bull media-scan queue â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Bull requires its own Redis connection (blocking clients). Defaults to the
# same Redis as REDIS_HOST/PORT. ClamAV scan runs in an in-process Bull worker;
# /media/confirm enqueues a job and returns scanStatus:"PENDING" (only when
# CLAMAV_ENABLED=true â€” in dev with the no-op scanner, confirm stays synchronous
# and returns CLEAN). Poll GET /media/scan-status until CLEAN.
BULL_REDIS_HOST=127.0.0.1
BULL_REDIS_PORT=6379
# Only set when Bull points at a DIFFERENT Redis than REDIS_HOST above.
# Left empty, the Bull connection reuses REDIS_PASSWORD.
BULL_REDIS_PASSWORD=
MEDIA_SCAN_QUEUE_NAME=media-scan
MEDIA_SCAN_CONCURRENCY=2
MEDIA_SCAN_JOB_ATTEMPTS=3
MEDIA_SCAN_BACKOFF_MS=5000

# â”€â”€â”€ MongoDB (media_db) â€” the MediaFile registry â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# One row per uploaded object: ownership, resource classification, scan verdict,
# and lifecycle. Reuses the running Mongo replica set (same parts as
# chat-service). Provide a complete MONGO_DATABASE_URL, or the MONGO_* parts and
# the URL is composed (directConnection=true for the single-node replica set).
# Run `pnpm --filter @aimess/media-service db:push` after the parts are set.
MONGO_HOST=localhost
MONGODB_PORT=27017
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=admin
MONGO_DB_NAME=aimess_media

# =========================
# Internal gRPC service auth
# =========================
# Shared bearer token every service attaches to outgoing gRPC calls and
# validates on incoming ones. MUST be identical across ALL services.
# Unset + NODE_ENV=production => services refuse to start (fail fast rather
# than silently accepting anonymous internal calls). Unset in dev => auth is
# disabled with a startup warning. A value published in this repository (the
# old "dev-grpc-service-token-change-me") is now rejected in production too.
# Generate one per environment: openssl rand -base64 32
GRPC_SERVICE_TOKEN=
