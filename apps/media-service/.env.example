NODE_ENV=development
MEDIA_SERVICE_PORT=3009
MEDIA_GRPC_PORT=4009

JWT_ACCESS_SECRET=your-jwt-access-secret-here

CORS_ALLOWED_ORIGINS=*

# MinIO / S3 compatible storage
MINIO_ENDPOINT=http://10.0.127.227:9000

# Client-facing MinIO host used to sign upload/view URLs (tunnel URL so teammates can access media).
MINIO_PUBLIC_ENDPOINT=http://10.0.127.227:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET_AVATARS=aimess-avatars
MINIO_BUCKET_COMMUNITY=aimess-community
MINIO_BUCKET=aimess-chat
MINIO_PRESIGN_EXPIRES_IN=900
MINIO_VIEW_EXPIRES_IN=3600

# Permanent signed media view URLs (optional — falls back to direct presigned if unset).
# Set both vars in every service (user, community, chat, backoffice, media).
# MEDIA_VIEW_PROXY_BASE_URL = gateway base URL reachable by clients.
# MEDIA_SIGN_SECRET must be identical across ALL services (min 32 chars).
MEDIA_SIGN_SECRET=change-me-use-a-long-random-secret-min-32-chars
MEDIA_VIEW_PROXY_BASE_URL=http://localhost:8000/api/v1/media

AVATAR_MAX_UPLOAD_BYTES=5242880
COMMUNITY_IMAGE_MAX_UPLOAD_BYTES=5242880
CHAT_VIDEO_MAX_BYTES=104857600
COMMUNITY_CHAT_MAX_BYTES=104857600
