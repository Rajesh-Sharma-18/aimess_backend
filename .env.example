# =========================
# PostgreSQL
# =========================
POSTGRES_USER=
POSTGRES_PASSWORD=
# Leave unset or use postgres so docker/postgres/init can CREATE DATABASE aimess_* on first boot.
# POSTGRES_DB=postgres
POSTGRES_PORT=


# =========================
# MongoDB
# =========================

MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=
MONGODB_PORT=


# =========================
# Redis
# =========================

REDIS_PORT=


# =========================
# RabbitMQ
# =========================

RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

RABBITMQ_PORT=
RABBITMQ_MANAGEMENT_PORT=


# =========================
# MinIO
# =========================

# Interface the local stack publishes its datastores on.
#
# Postgres, Mongo, Redis, RabbitMQ, MinIO and the admin consoles run WITHOUT
# authentication in this compose file (Mongo cannot have `--auth` alongside
# `--replSet` without a mounted keyfile, which is painful on Windows and is why
# the stack is built this way). Published on 0.0.0.0 they were reachable by
# anyone on the same café or office network as the developer's laptop.
#
# Loopback removes the reachability without needing a connection-string change
# anywhere. Set it to 0.0.0.0 only if you deliberately need another machine — a
# phone on the LAN, say — to reach the datastores directly.
INFRA_BIND_ADDR=127.0.0.1

# Per-service MinIO account secrets (AIM-25).
#
# Six services used to hold the MinIO ROOT credentials, which can read and
# delete every object in every bucket and drop the buckets themselves — so a
# leak from any one of them handed over all user media at once. Each service now
# authenticates as its own account, scoped by `deploy/minio/init-buckets.sh` to
# the buckets that service actually names.
#
# Generate with `node scripts/generate-secrets.mjs --rotate media` or
# `openssl rand -base64 32`. Rotating one is: change it here, change the same
# value in that service's .env, and restart the stack — `minio-init` re-applies
# it on every start.
MINIO_SECRET_MEDIA=
MINIO_SECRET_USER=
MINIO_SECRET_CHAT=
MINIO_SECRET_COMMUNITY=
MINIO_SECRET_STREAM=
MINIO_SECRET_BACKOFFICE=

# Root credentials. These stay with the OPERATOR and belong in no service's
# .env — `minio-init` is the only consumer.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

MINIO_API_PORT=
MINIO_CONSOLE_PORT=


# =========================
# pgAdmin (docker-compose.yml only)
# =========================

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

PGADMIN_PORT=


# =========================
# Redis Commander (docker-compose.yml only)
# =========================

REDIS_COMMANDER_PORT=


# =========================
# stream-service (docker-compose.yml `stream-service` block)
# =========================
# NODE_ENV defaults to `production` in compose when unset; set `development` for dev.
NODE_ENV=
# Same JWT_ACCESS_SECRET as auth-service / user-service (token verification).
JWT_ACCESS_SECRET=
# Shared secret the stream-service /internal/srs/hooks endpoint validates on SRS callbacks.
SRS_HOOK_SECRET=


# =========================
# LiveKit (docker-compose.yml `livekit` block)
# =========================
# Shared by the LiveKit server AND chat-service (token minting).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PORT=
LIVEKIT_RTC_TCP_PORT=
# Handed to clients as `livekitUrl`. Must be reachable FROM THE DEVICE — the
# ws://localhost:7880 default points a phone at itself. Match docker/livekit
# config.yaml `node_ip`. Production must be wss://.
LIVEKIT_URL=

# =========================
# Internal gRPC service auth
# =========================
# Shared bearer token every service attaches to outgoing gRPC calls and
# validates on incoming ones. MUST be identical across ALL services.
# Unset + NODE_ENV=production => services refuse to start (fail fast rather
# than silently accepting anonymous internal calls). Unset in dev => auth is
# disabled with a startup warning. A value published in this repository (the
# old "dev-grpc-service-token-change-me") is now rejected in production too.
# Generate one per environment: openssl rand -base64 32
GRPC_SERVICE_TOKEN=
