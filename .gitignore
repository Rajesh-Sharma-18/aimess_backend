# ENV FILES
.env
.env.*
!.env.example
# Deployment templates carry no secrets and MUST be committed. Without these
# two exceptions the `.env.*` rule above swallows them, and a fresh clone has
# nothing to copy from on the server.
!deploy/*/.env.*.example
# ...but the filled-in copies next to them never get committed.
deploy/*/.env.dev01
deploy/*/.env.dev02

# DEPLOYMENT — rendered from config.yaml.template; contains the Redis password.
deploy/livekit/config.yaml

# NODE
node_modules

# BUILD
dist
*.tsbuildinfo
.next
.turbo
_deploy-*

# LOGS
logs
*.log

# Gateway runtime app-version overrides (use app-versions.example.json as template)
apps/api-gateway/config/app-versions.json

# OS
.DS_Store
Thumbs.db

# Claude Code — local only (skills under .claude/skills/ are committed)
.claude/worktrees/
/graphify-out
/testing-suite

*.md
# The deployment runbook is operational, not documentation: deploy/README.md is
# the procedure the server-side scripts reference by name, so a fresh clone on
# a server must contain it.
!deploy/README.md
!deploy/ARCHITECTURE.md
!deploy/OPERATIONS.md
!deploy/DOMAINS-AND-STATUS.md
!deploy/scripts/*.md
tree-data.json
community_*.json
demo-frontend/
demo-frontend/*.tsx

.vscode
.claude
.serena
docs/
# ponytail: this is source, not generated docs — the broad docs/ rule above swallows new files here
!apps/api-gateway/src/docs/
!apps/api-gateway/src/docs/**

CLAUDE.md
COMMUNITY_CHAT_INTEGRATION_GUIDE.md
COMMUNITY_SHARING_DEEPLINKING_BACKEND_AUDIT.md
FRONTEND_COMMUNITY_SHARING_AND_DEEPLINKING_INTEGRATION.md
FRONTEND_MEDIA_AND_CHAT_INTEGRATION_GUIDE.md

stream-app/
.pnpm-store
*.mjs
# The blanket *.mjs rule above silently swallowed first-party build tooling: every
# committed .mjs in this repo had to be `git add -f`'d, and
# apps/stream-service/scripts/prisma-generate-if-needed.mjs sat in that service's
# build script for a month while never existing in any checkout.
#
# These negations re-include only *.mjs, never whole directories — a bare
# `!tooling/**` would also resurrect node_modules/, dist/ and .turbo/ beneath it,
# because those are ignored by pattern rather than by an ignored parent directory.
# Generated/vendored .mjs outside these paths stays ignored.
!/*.config.mjs
!/scripts/**/*.mjs
!/tools/**/*.mjs
!/tooling/*/scripts/**/*.mjs
!/apps/*/scripts/**/*.mjs
!/apps/*/tools/**/*.mjs
!/packages/*/scripts/**/*.mjs
stream_*.json
test-ui
