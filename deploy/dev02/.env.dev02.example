# =============================================================================
# Dev 02 — 76.13.216.171 — copy to `.env.dev02` and fill in every blank.
#
#   cp .env.dev02.example .env.dev02 && chmod 600 .env.dev02
#
# Generate each secret with:  openssl rand -base64 36
# Never reuse a value between two different secrets.
#
# This single file is loaded by EVERY service in deploy/dev02/compose.yml.
# Values that differ per service (ports, gRPC targets, MONGO_DB_NAME, database
# URLs) are set in the compose file's `environment:` blocks and MUST NOT be
# duplicated here — compose `environment:` wins over `env_file:`, so a stray
# entry here is silently ignored and becomes a debugging trap.
# =============================================================================

NODE_ENV=production

# --- Peer addresses ----------------------------------------------------------
LAN_IP=76.13.216.171
DEV01_IP=76.13.216.164

# --- Credentials for the Dev 01 datastores -----------------------------------
# Must match deploy/dev01/.env.dev01 exactly. Compose interpolates these into
# the per-service AUTH_DATABASE_URL / USER_DATABASE_URL / ADMIN_DATABASE_URL /
# COMMUNITY_DATABASE_URL connection strings.
POSTGRES_USER=aimess
POSTGRES_PASSWORD=
MONGO_ROOT_USERNAME=aimess
MONGO_ROOT_PASSWORD=

# --- MongoDB connection parts ------------------------------------------------
# chat / media / notifications compose their own URL from these (see each
# service's src/config/env.ts). community-service instead gets a full URL from
# the compose file.
MONGO_HOST=76.13.216.164
MONGODB_PORT=27017
# This is the AUTH SOURCE, not the data database. It must be `admin` — the root
# user is defined there. Leaving it empty produces authSource= and every
# connection fails authentication.
MONGO_DATABASE=admin

# --- Redis (existing instance on the database server) ------------------------
REDIS_HOST=187.77.130.157
REDIS_PORT=52023
REDIS_PASSWORD=
REDIS_CACHE_ENABLED=true
# api-gateway takes a URL rather than host/port/password. Embed the password and
# URL-encode any of : / ? # [ ] @ that appear in it.
#   redis://:<url-encoded-password>@187.77.130.157:52023
REDIS_URL=
# Bull (media-service scan queue) shares the same instance, so leave this empty.
BULL_REDIS_HOST=187.77.130.157
BULL_REDIS_PORT=52023
BULL_REDIS_PASSWORD=

# --- RabbitMQ ----------------------------------------------------------------
# Must match deploy/dev01/.env.dev01. URL-encode special characters in the
# password. Note the dev .env.example files disagree on the port (5672 vs 5673)
# — production is 5672 everywhere.
#   amqp://<user>:<url-encoded-pass>@76.13.216.164:5672
RABBITMQ_URL=

# --- MinIO -------------------------------------------------------------------
# MINIO_ENDPOINT is the SERVER-SIDE address used to talk to MinIO directly.
# MINIO_PUBLIC_ENDPOINT is what presigned URLs are signed against and handed to
# browsers — it must be the public HTTPS origin, and must match Dev 01's
# MINIO_SERVER_URL or every signature is rejected.
MINIO_ENDPOINT=http://76.13.216.164:9000
MINIO_PUBLIC_ENDPOINT=https://minio.ai5dev.tech
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_BUCKET_AVATARS=aimess-avatars
MINIO_BUCKET_COMMUNITY=aimess-community
MINIO_BUCKET_STREAM=aimess-stream
MINIO_PRESIGN_EXPIRES_IN=900
MINIO_VIEW_EXPIRES_IN=3600
MINIO_AVATAR_VIEW_EXPIRES_IN=3600
MINIO_IMAGE_VIEW_EXPIRES_IN=3600
MINIO_STREAM_THUMBNAIL_UPLOAD_EXPIRES_IN=300

# --- Internal service auth ---------------------------------------------------
# Attached to every outgoing gRPC call and validated on every incoming one.
# MUST be byte-identical across ALL services, including stream-service on the
# stream server. With NODE_ENV=production, a service REFUSES TO START if this
# is unset — that is deliberate, not a bug.
GRPC_SERVICE_TOKEN=
# Guards the internal HTTP routes between api-gateway and community-service.
INTERNAL_SHARED_SECRET=

# --- JWT ---------------------------------------------------------------------
# JWT_ACCESS_SECRET is shared by every service that verifies user tokens
# (gateway, auth, user, chat, community, media, stream) — it must be identical
# everywhere, including on the stream server.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800
JWT_REFRESH_EXPIRES_IN_REMEMBER_ME=2592000
# Admin tokens are a SEPARATE trust domain from user tokens. Never reuse the
# user secrets here — doing so would let a user token authenticate as an admin.
JWT_ADMIN_SECRET=
JWT_ADMIN_REFRESH_SECRET=
JWT_ADMIN_EXPIRES_IN=28800
JWT_ADMIN_REFRESH_EXPIRES_IN=604800

# --- Public origins / CORS ---------------------------------------------------
PUBLIC_API_ORIGIN=https://api.ai5dev.tech
PUBLIC_WEB_ORIGINS=https://website.ai5dev.tech
ADMIN_WEB_ORIGIN=https://admin.ai5dev.tech
# Consumer-facing services. Comma-separated, no trailing slash, no wildcard —
# credentials are sent cross-origin and `*` is rejected by browsers when they are.
CORS_ALLOWED_ORIGINS=https://website.ai5dev.tech
CORS_ALLOWED_HEADERS=Content-Type,Authorization,x-lang

# --- stream-service ----------------------------------------------------------
# CORRECTION (verified 2026-08-06 on 72.62.69.126): stream-service is NOT on the
# stream server. That host runs ONLY SRS (RTMP 1935 + internal 1936/1937/1984/
# 1985/8080) behind nginx for ai5stream.tech. Nothing listens on 3007 or 4007.
# The running stream-service belongs to the OTHER environment, at
# aimess.api.vasundharasolutions.com (13.203.130.146).
#
# So stream-service runs HERE on Dev 02 with the other services, and these are
# compose-network addresses set in compose.yml — not remote hosts.
STREAM_GRPC_URL=stream-service:4007
STREAM_SERVICE_URL=http://stream-service:3007
STREAM_DATABASE_URL=mongodb://REPLACE_USER:REPLACE_PASS@76.13.216.164:27017/stream_db?authSource=admin&directConnection=true

# --- SRS (remote media server, ai5stream.tech) -------------------------------
# Read from the live nginx vhost on 72.62.69.126:
#   /ingest/  -> :1984  (WHIP ingest)      /rtc/ , /api/ -> :1985
#   *.flv , /players/ , /live/*.m3u8 -> :8080  (HTTP-FLV + HLS playback)
SRS_API_URL=https://ai5stream.tech/api
SRS_RTMP_HOST=ai5stream.tech
SRS_HLS_BASE=https://ai5stream.tech
SRS_WHIP_BASE=https://ai5stream.tech/ingest
# ⚠ This is the secret ALREADY configured in SRS's rtmp2rtc.conf http_hooks.
# Those hooks currently POST to aimess.api.vasundharasolutions.com — the OTHER
# environment. Until SRS is repointed (or given a second hook URL), livestreams
# started here will never transition PENDING -> LIVE. See deploy/README.md §7.
SRS_HOOK_SECRET=3ffbbfb2c073a9b9f8d52c2235f1341b
FFMPEG_PATH=ffmpeg
STREAM_INGEST_MODES=whip,rtmp
STREAM_MAX_CONCURRENT_PER_COMMUNITY=5
STREAM_REQUIRE_MEMBERSHIP=true

# --- LiveKit -----------------------------------------------------------------
# Key and secret must be IDENTICAL to deploy/dev01/.env.dev01 — chat-service
# mints tokens here that the LiveKit server on Dev 01 validates.
# LIVEKIT_URL is handed to browsers, so it must be the PUBLIC wss:// origin.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Handed to browsers, so it must be the public wss:// origin. Reuses the spare
# `notification` subdomain — see deploy/nginx/sites/dev01-livekit.conf.
LIVEKIT_URL=wss://notification.ai5dev.tech
LIVEKIT_TOKEN_TTL=3600
CALL_RINGING_TIMEOUT_SEC=60
CALL_TIMEOUT_SWEEP_INTERVAL_SEC=15
CALL_TIMEOUT_SWEEP_BATCH=100

# --- "Login Detected" alert ---------------------------------------------------
# All three match the defaults in apps/chat-service/src/config/env.ts, so the
# service behaves identically with or without them. They are listed here to be
# tunable without a code change and a rebuild.
# How long the alert stays actionable (Terminate / It's Me). When it lapses with
# no user action the sweep resolves it as "It's Me" — the session is NEVER
# auto-terminated. 1 hour. Lower it only for manual testing.
LOGIN_DETECTION_TIMEOUT_MS=3600000
# How often each chat-service node looks for lapsed Login Detected alerts.
LOGIN_EXPIRY_SWEEP_INTERVAL_SEC=60
LOGIN_EXPIRY_SWEEP_BATCH=200

# --- Rate limiting -----------------------------------------------------------
GLOBAL_RATE_LIMIT_WINDOW_MINUTES=1
GLOBAL_RATE_LIMIT_MAX=200
SENSITIVE_AUTH_RATE_LIMIT_WINDOW_MINUTES=15
SENSITIVE_AUTH_RATE_LIMIT_MAX=20
ADMIN_RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_RATE_LIMIT_MAX=100
ADMIN_LOGIN_RATE_LIMIT_MAX=10
# Comma-separated CIDRs allowed to reach admin routes. Empty = no IP restriction.
ADMIN_IP_WHITELIST=

# --- Auth / OTP policy -------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_MAX=5
OTP_REQUEST_WINDOW_SEC=900
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
QR_LINK_TTL_SECONDS=60
QR_LINK_SWEEP_GRACE_SECONDS=30
QR_LINK_SWEEPER_ENABLED=true
QR_LINK_SWEEPER_INTERVAL_MS=30000
# ⚠ MUST be empty in production. Any value here is accepted as a valid OTP for
# every account, which is a complete authentication bypass.
OTP_DEV_FIXED_CODE=
ADMIN_OTP_DEV_FIXED_CODE=

# --- Admin OTP / bootstrap ---------------------------------------------------
ADMIN_OTP_LENGTH=6
ADMIN_OTP_TTL_SECONDS=300
ADMIN_OTP_MAX_ATTEMPTS=5
ADMIN_OTP_REQUEST_MAX=5
ADMIN_OTP_REQUEST_WINDOW_SEC=900
ADMIN_OTP_RESEND_COOLDOWN_SEC=60
ADMIN_PASSWORD_RESET_TOKEN_TTL_SECONDS=600
# Creates the first super admin on first boot. Change the password immediately
# after the first login, then blank these two.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin
ADMIN_DEFAULT_AVATAR_BASE_URL=https://api.dicebear.com/9.x/initials/svg

# --- SMTP (backoffice + notifications) ---------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Social login ------------------------------------------------------------
GOOGLE_OAUTH_APPLE_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
APPLE_CLIENT_IDS=

# --- Push notifications ------------------------------------------------------
# Must be Firebase project `aimess-app` — the same config is hardcoded in the
# website's public/firebase-messaging-sw.js and the two must agree.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Multi-line PEM. Keep it on one line with literal \n escapes.
FIREBASE_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_PRODUCTION=true

# --- Deep links / app metadata -----------------------------------------------
# Only ai5dev.tech names are used here. The aimess.me / aimess.com values in the
# apps/*/.env.example files belong to a different environment and are NOT used.
LINK_HOSTS=website.ai5dev.tech
APP_SCHEME=aimess
WEB_APP_URL=https://website.ai5dev.tech
INVITE_LINK_BASE_URL=https://website.ai5dev.tech
ANDROID_PACKAGE_NAME=com.aimess.app
ANDROID_SHA256_CERT_FINGERPRINTS=
APPLE_APP_IDS=
APP_VERSION_ANDROID_MANDATORY=1.0.0
APP_VERSION_ANDROID_OPTIONAL=1.0.0
APP_VERSION_IOS_MANDATORY=1.0.0
APP_VERSION_IOS_OPTIONAL=1.0.0

# --- media-service / chat limits ---------------------------------------------
# ⚠ CHAT_VIDEO_MAX_BYTES is exactly 100 MB, which is also Cloudflare's free-plan
# upload cap. If minio.ai5dev.tech is PROXIED (orange cloud), uploads at this
# size fail with a 413 from Cloudflare before reaching MinIO. Either grey-cloud
# that record (recommended) or lower this limit.
CHAT_UPLOAD_MAX_BYTES=52428800
CHAT_VIDEO_MAX_BYTES=104857600
CHAT_IMAGE_MAX_BYTES=26214400
CHAT_AUDIO_MAX_BYTES=26214400
CHAT_DOCUMENT_MAX_BYTES=26214400
COMMUNITY_CHAT_MAX_BYTES=104857600
GROUP_CHAT_MAX_BYTES=104857600
AVATAR_MAX_UPLOAD_BYTES=5242880
COMMUNITY_IMAGE_MAX_UPLOAD_BYTES=5242880
CHAT_TEXT_MAX_CHARS=4000
MESSAGE_PAGE_SIZE=30
CONVERSATION_PAGE_SIZE=20
PIN_LIMIT_PER_ROOM=50

# --- AV scanning (optional; start the `clamav` compose profile to use) --------
CLAMAV_ENABLED=false
CLAMAV_SCAN_TIMEOUT_MS=30000
ZIP_MAX_COMPRESSION_RATIO=100
SCAN_STATUS_TTL_SECONDS=604800
MEDIA_SCAN_QUEUE_NAME=media-scan
MEDIA_SCAN_CONCURRENCY=2
MEDIA_SCAN_JOB_ATTEMPTS=3
MEDIA_SCAN_BACKOFF_MS=5000

# --- Misc cache / behaviour knobs --------------------------------------------
REDIS_CACHE_USERNAME_AVAIL_TTL_SEC=60
REDIS_CACHE_USERNAME_TAKEN_TTL_SEC=86400
REDIS_CACHE_NAME_AVAIL_TTL_SEC=60
REDIS_CACHE_NAME_TAKEN_TTL_SEC=86400
REDIS_CACHE_PROFILE_TTL_SEC=120
REDIS_CACHE_ACCOUNT_TTL_SEC=300
NOTIF_SETTINGS_CACHE_TTL_SEC=300
FRIENDSHIP_CACHE_TTL_SEC=600
COMMUNITY_ROOM_RECONCILE_ENABLED=true
AUTH_SERVICE_TIMEOUT_MS=3000
COMMUNITY_INVITE_CREATE_RATE_MAX=20
COMMUNITY_INVITE_CREATE_RATE_WINDOW_SEC=3600
COMMUNITY_INVITE_BULK_RATE_MAX=10
COMMUNITY_INVITE_BULK_RATE_WINDOW_SEC=3600
COMMUNITY_INVITE_MAX_ACTIVE_LINKS_PER_MEMBER=20
