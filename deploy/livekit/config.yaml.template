# LiveKit — PRODUCTION config template for Dev 01 (76.13.216.164).
#
# This is a TEMPLATE. Render it before the first `docker compose up`:
#
#   set -a && . ../dev01/.env.dev01 && set +a
#   envsubst < config.yaml.template > config.yaml
#
# Rendering explicitly (rather than relying on the server to expand ${VARS} at
# load time) keeps this working regardless of LiveKit's config-parsing
# behaviour, and makes the live values inspectable with `cat config.yaml`.
# config.yaml is gitignored — it contains the Redis password.
#
# ⚠️ LiveKit reads its config ONCE AT STARTUP. After re-rendering you MUST
# `docker compose restart livekit`, otherwise it keeps advertising the OLD
# node_ip and every call fails with "could not establish pc connection" while
# signaling still works — which looks exactly like an application bug.
# Verify what is actually live:
#   docker logs aimess-livekit | grep "starting LiveKit server"   → "nodeIP"

port: 7880
log_level: info

rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100

  # This box has its public IP bound directly to eth0 (no NAT), so we advertise
  # it explicitly rather than relying on an external-IP lookup — one less
  # startup dependency, and it cannot guess wrong.
  use_external_ip: false
  node_ip: ${DEV01_IP}

redis:
  # Reuses the existing Redis on the database server. LiveKit uses it only for
  # multi-node coordination; a single SFU works fine, but keeping it configured
  # means adding a second node later needs no config surgery.
  address: ${REDIS_HOST}:${REDIS_PORT}
  password: ${REDIS_PASSWORD}

# Embedded TURN over TLS — part of livekit-server itself, NOT a separate daemon.
# Relays media for clients whose network blocks the direct UDP path: corporate
# and campus wifi, some mobile carriers, VPNs, symmetric NAT. Without it those
# clients complete signaling, join the room, and then fail with
# DisconnectReason 14 (CONNECTION_TIMEOUT) — which looks like an intermittent
# application bug because it depends entirely on whose network each peer is on.
#
# Reuses the SAME certificate nginx already serves for the signaling vhost
# (deploy/nginx/sites/dev01-livekit.conf), mounted read-only into the container
# by deploy/dev01/compose.yml. Nothing extra to issue.
#
# ⚠ `domain` MUST resolve straight to this host. TURN speaks TLS on 5349, not
# HTTP on 443, so a Cloudflare-proxied record sends clients to an edge that is
# not listening on that port and TURN is silently dead — the exact failure it
# exists to prevent. media.ai5stream.tech is already DNS-only, so this is safe.
#
# ⚠ The certificate renews every 90 days and LiveKit reads it ONCE at startup.
# deploy/scripts/05-issue-certs.sh installs a renewal hook that restarts this
# container; without it TURN keeps serving an expired cert three months later.
turn:
  enabled: true
  domain: ${LIVEKIT_DOMAIN}
  tls_port: 5349
  # Mounted at the SAME path inside the container as on the host, deliberately:
  # `live/<domain>/fullchain.pem` is a relative symlink into `../../archive/`,
  # so mounting the leaf directory alone yields two dangling links and LiveKit
  # exits at startup. Identical paths keep every symlink resolvable.
  cert_file: /etc/letsencrypt/live/${LIVEKIT_DOMAIN}/fullchain.pem
  key_file: /etc/letsencrypt/live/${LIVEKIT_DOMAIN}/privkey.pem

# LiveKit signs each webhook with the api_key below and POSTs to the gateway,
# which runs on Dev 02 and is reachable only via its public origin. This must
# match the api_key half of LIVEKIT_KEYS.
webhook:
  api_key: ${LIVEKIT_API_KEY}
  urls:
    - ${PUBLIC_API_ORIGIN}/livekit/webhook
