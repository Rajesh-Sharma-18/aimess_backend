# =============================================================================
# Dev 01 — 76.13.216.164 — copy to `.env.dev01` and fill in every blank.
#
#   cp .env.dev01.example .env.dev01 && chmod 600 .env.dev01
#
# Generate each secret with:  openssl rand -base64 36
# Never reuse a value between two different secrets.
# =============================================================================

# --- Host identity -----------------------------------------------------------
# LAN_IP is what Docker publishes database ports on, and what the Mongo replica
# set advertises. It must be the address Dev 02 uses to reach this box.
LAN_IP=76.13.216.164
DEV01_IP=76.13.216.164
DEV02_IP=76.13.216.171

# --- PostgreSQL --------------------------------------------------------------
# On FIRST boot only, docker/postgres/init/01-create-databases.sql creates:
#   aimess_auth, aimess_users, aimess_communities, aimess_moderation, admin_db
# Changing this password later does NOT re-run init — use ALTER USER instead.
POSTGRES_USER=aimess
POSTGRES_PASSWORD=

# --- MongoDB -----------------------------------------------------------------
# Replica set rs0, single node, WITH auth. Services connect as this root user
# with authSource=admin.
MONGO_ROOT_USERNAME=aimess
MONGO_ROOT_PASSWORD=
# Absolute path on the HOST to the internal-auth keyfile. Created by
# deploy/scripts/00-bootstrap-host.sh. Must be owned by uid 999 and mode 0400 —
# mongod refuses to start if it is group- or world-readable.
MONGO_KEYFILE_PATH=/opt/aimess/mongo-keyfile

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_DEFAULT_USER=aimess_rabbit
RABBITMQ_DEFAULT_PASS=

# --- MinIO -------------------------------------------------------------------
# MINIO_ROOT_USER must be at least 3 chars, the password at least 8.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# The PUBLIC HTTPS origin. Presigned upload/download URLs are SIGNED against
# this value — if it does not match what the browser actually requests, every
# signature is rejected as invalid.
MINIO_PUBLIC_URL=https://minio.ai5dev.tech
# Reuses the spare `auth` subdomain — auth-service is internal only and must
# NOT be public (a direct route would bypass the gateway's rate limiting).
MINIO_CONSOLE_PUBLIC_URL=https://auth.ai5dev.tech

# --- LiveKit -----------------------------------------------------------------
# LIVEKIT_API_KEY / SECRET must be IDENTICAL here and in Dev 02's .env.dev02 —
# chat-service mints the tokens that this server validates.
# The secret must be at least 32 characters.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Reuses the spare `notification` subdomain — notification-service needs no
# public name of its own. Must be GREY-CLOUD (DNS-only) pointing at 76.13.216.164:
# Cloudflare's proxy cannot carry LiveKit's UDP media.
LIVEKIT_DOMAIN=media.ai5stream.tech

# --- Redis (existing instance on the database server) ------------------------
# Reused as-is; nothing Redis-related is deployed by this stack.
REDIS_HOST=187.77.130.157
REDIS_PORT=52023
REDIS_PASSWORD=

# --- Public origins ----------------------------------------------------------
# Used to render deploy/livekit/config.yaml.template (LiveKit webhook target).
PUBLIC_API_ORIGIN=https://api.ai5dev.tech
