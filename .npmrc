# Prevent the prisma CLI binary from being hoisted to the root node_modules/.bin.
# auth-service and user-service use Prisma 7; community-service uses Prisma 6
# (Prisma 7 dropped MongoDB support). Without this, pnpm picks the highest version
# for the root slot and community-service ends up calling the Prisma 7 CLI.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@types/*
